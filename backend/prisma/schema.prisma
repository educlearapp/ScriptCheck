// ─── Workspace (organisation) ─────────────────────────────────────────────────

model Workspace {
  id                 String             @id @default(cuid())
  name               String
  slug               String             @unique
  type               WorkspaceType
  subscriptionPlan   SubscriptionPlan   @default(PAID)
  subscriptionStatus SubscriptionStatus @default(ACTIVE)
  trialExpiresAt     DateTime?
  email              String?
  phone              String?
  address            String?
  logoUrl            String?
  createdAt          DateTime           @default(now())
  updatedAt          DateTime           @updatedAt

  memberships                  WorkspaceMembership[]
  workflowConfig               WorkspaceWorkflowConfig?
  assessments                  Assessment[]
  auditLogs                    AuditLog[]
  assessmentGenerationRequests AssessmentGenerationRequest[]
  questionBankItems            QuestionBankItem[]
  assessmentTemplates          AssessmentTemplate[]
  learners                     Learner[]
  scriptBatches                ScriptBatch[]
  examSessions                 ExamSession[]
  workspaceSubjects            WorkspaceSubject[]
  rubricTemplates              RubricTemplate[]
  learnerAssessmentMarks       LearnerAssessmentMark[]
  learnerAtRiskFlags           LearnerAtRiskFlag[]
  learnerInterventions         LearnerIntervention[]
  examReadinessSnapshots       ExamReadinessSnapshot[]
  paperVaultDocuments          PaperVaultDocument[]
  learnerConcessions           LearnerConcession[]
  portalAccounts               PortalAccount[]
  portalOtps                   PortalOtp[]
  parentLearnerLinks           ParentLearnerLink[]
  examVenues                   ExamVenue[]
  examinationTimetables        ExaminationTimetable[]
  examinationSlots             ExaminationSlot[]
  examinationOpsSessions       ExaminationOpsSession[]
  invigilatorAssignments       InvigilatorAssignment[]
  seatingPlans                 SeatingPlan[]
  examinationIncidents         ExaminationIncident[]
  aiAssessmentBuilderRequests  AiAssessmentBuilderRequest[]
  markAdjustments              MarkAdjustmentAudit[]
  betaFeedback                 BetaFeedback[]
  schoolClasses                SchoolClass[]
  timetableRooms               TimetableRoom[]
  schoolDayTemplates           SchoolDayTemplate[]
  periodDefinitions            PeriodDefinition[]
  teacherAssignments           TeacherAssignment[]
  subjectRequirements          SubjectRequirement[]
  lessonTimetables             LessonTimetable[]
  lessonEntries                LessonEntry[]
}

// ─── User (global identity — no workspace or role on the record itself) ───────

model User {
  id           String    @id @default(cuid())
  email        String    @unique
  passwordHash String
  fullName     String
  isActive     Boolean   @default(true)
  isSuperAdmin Boolean   @default(false)
  lastLoginAt  DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  memberships        WorkspaceMembership[]
  createdAssessments              Assessment[]                    @relation("AssessmentCreator")
  assignedAssessments             Assessment[]                    @relation("AssessmentAssignee")
  moderationAudits                AssessmentModerationAudit[]
  auditLogsAsActor                AuditLog[]                      @relation("AuditActor")
  auditLogsAsTarget               AuditLog[]                      @relation("AuditTarget")
  assessmentGenerationRequests    AssessmentGenerationRequest[]   @relation("GenerationRequestCreator")
  generatedAssessments            GeneratedAssessment[]           @relation("GeneratedAssessmentAuthor")
  questionBankItemsCreated        QuestionBankItem[]              @relation("QuestionBankCreator")
  questionBankItemsApproved       QuestionBankItem[]              @relation("QuestionBankApprover")
  assessmentTemplatesCreated      AssessmentTemplate[]            @relation("TemplateCreator")
  scriptBatchesCreated            ScriptBatch[]                   @relation("ScriptBatchCreator")
  teacherScriptMarks              ScriptQuestionMark[]            @relation("TeacherMarker")
  hodScriptMarks                  ScriptQuestionMark[]            @relation("HodModerator")
  scriptAnnotationLayers          ScriptAnnotationLayer[]         @relation("AnnotationAuthor")
  learnerFeedbackAuthored         LearnerFeedback[]               @relation("FeedbackAuthor")
  scriptPagesUploaded             ScriptPage[]                    @relation("ScriptPageUploader")
  scriptsFinalised                LearnerScript[]                 @relation("ScriptFinaliser")
  examSessionsCreated             ExamSession[]                   @relation("ExamSessionCreator")
  workspaceSubjectsCreated        WorkspaceSubject[]              @relation("WorkspaceSubjectCreator")
  rubricTemplatesCreated          RubricTemplate[]                @relation("RubricTemplateCreator")
  rubricTemplatesApproved         RubricTemplate[]                @relation("RubricTemplateApprover")
  learnerAssessmentMarksCaptured  LearnerAssessmentMark[]         @relation("MarkCaptureAuthor")
  rubricTeacherMarks              ScriptRubricMark[]              @relation("RubricTeacherMarker")
  rubricHodMarks                  ScriptRubricMark[]              @relation("RubricHodModerator")
  paperVaultDocumentsUploaded     PaperVaultDocument[]            @relation("PaperVaultUploader")
  interventionsCreated            LearnerIntervention[]           @relation("InterventionCreator")
  interventionsUpdated            LearnerIntervention[]           @relation("InterventionUpdater")
  examinationTimetablesCreated    ExaminationTimetable[]          @relation("ExamTimetableCreator")
  examinationOpsSessionsCreated   ExaminationOpsSession[]         @relation("ExamOpsSessionCreator")
  invigilatorAssignments          InvigilatorAssignment[]         @relation("InvigilatorUser")
  invigilatorAssignmentsCreated   InvigilatorAssignment[]         @relation("InvigilatorAssigner")
  seatingPlansCreated             SeatingPlan[]                   @relation("SeatingPlanCreator")
  examinationIncidentsReported    ExaminationIncident[]           @relation("IncidentReporter")
  aiAssessmentBuilderRequests     AiAssessmentBuilderRequest[]    @relation("AiBuilderCreator")
  aiStudyMaterialsUploaded        AiStudyMaterial[]               @relation("AiMaterialUploader")
  moderationCommentsAuthored      ModerationComment[]             @relation("ModerationCommentAuthor")
  approvalRequestsCreated         ModerationApprovalRequest[]     @relation("ApprovalRequestCreator")
  approvalRequestsResponded       ModerationApprovalRequest[]     @relation("ApprovalRequestResponder")
  markAdjustmentsMade             MarkAdjustmentAudit[]           @relation("MarkAdjustmentAuthor")
  intelligenceReportsGenerated    AssessmentIntelligenceReport[] @relation("IntelligenceGenerator")
  betaFeedbackSubmitted         BetaFeedback[]                 @relation("BetaFeedbackAuthor")
  teacherAssignments            TeacherAssignment[]            @relation("TimetableTeacher")
  lessonTimetablesPublished     LessonTimetable[]              @relation("LessonTimetablePublisher")
  lessonEntriesTaught           LessonEntry[]                  @relation("LessonEntryTeacher")
}

// ─── Workspace membership (user ↔ workspace) ────────────────────────────────

model WorkspaceMembership {
  id          String   @id @default(cuid())
  userId      String
  workspaceId String
  isActive    Boolean  @default(true)
  invitedAt   DateTime?
  joinedAt    DateTime @default(now())
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  user      User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  workspace Workspace         @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  roles     MembershipRole[]

  @@unique([userId, workspaceId])
  @@index([workspaceId])
  @@index([userId])
}

// ─── Membership roles (multiple roles per workspace membership) ───────────────

model MembershipRole {
  id           String        @id @default(cuid())
  membershipId String
  role         WorkspaceRole
  createdAt    DateTime      @default(now())

  membership WorkspaceMembership @relation(fields: [membershipId], references: [id], onDelete: Cascade)

  @@unique([membershipId, role])
  @@index([membershipId])
}

// ─── Audit log foundation ─────────────────────────────────────────────────────

model AuditLog {
  id            String      @id @default(cuid())
  workspaceId   String?
  actorId       String?
  targetUserId  String?
  action        AuditAction
  metadata      Json?
  ipAddress     String?
  userAgent     String?
  createdAt     DateTime    @default(now())

  workspace  Workspace? @relation(fields: [workspaceId], references: [id], onDelete: SetNull)
  actor      User?      @relation("AuditActor", fields: [actorId], references: [id], onDelete: SetNull)
  targetUser User?      @relation("AuditTarget", fields: [targetUserId], references: [id], onDelete: SetNull)

  @@index([workspaceId, createdAt])
  @@index([actorId, createdAt])
  @@index([action, createdAt])
}

// ─── Curriculum catalog (global reference data) ─────────────────────────────

model Curriculum {
  id        String   @id @default(cuid())
  code      String   @unique
  name      String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  phases            Phase[]
  subjects          Subject[]
  assessments       Assessment[]
  workspaceSubjects WorkspaceSubject[]
}

model Phase {
  id           String   @id @default(cuid())
  curriculumId String
  code         String
  name         String
  orderIndex   Int
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  curriculum  Curriculum   @relation(fields: [curriculumId], references: [id], onDelete: Cascade)
  grades      Grade[]
  subjects    Subject[]
  assessments       Assessment[]
  workspaceSubjects WorkspaceSubject[]

  @@unique([curriculumId, code])
  @@index([curriculumId, orderIndex])
}

model Grade {
  id         String   @id @default(cuid())
  phaseId    String
  code       String
  name       String
  orderIndex Int
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  phase       Phase         @relation(fields: [phaseId], references: [id], onDelete: Cascade)
  assessments       Assessment[]
  learners          Learner[]
  workspaceSubjects WorkspaceSubject[]
  examinationTimetables ExaminationTimetable[]
  examinationSlots      ExaminationSlot[]
  examinationOpsSessions ExaminationOpsSession[]
  examReadinessSnapshots ExamReadinessSnapshot[]

  @@unique([phaseId, code])
  @@index([phaseId, orderIndex])
}

model Subject {
  id           String   @id @default(cuid())
  curriculumId String
  phaseId      String
  code         String
  name         String
  category     String?
  active       Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  curriculum  Curriculum   @relation(fields: [curriculumId], references: [id], onDelete: Cascade)
  phase       Phase        @relation(fields: [phaseId], references: [id], onDelete: Cascade)
  assessments       Assessment[]
  workspaceSubjects WorkspaceSubject[]
  rubricTemplates   RubricTemplate[]
  examinationTimetables ExaminationTimetable[]
  examinationSlots      ExaminationSlot[]
  examinationOpsSessions ExaminationOpsSession[]
  examReadinessSnapshots ExamReadinessSnapshot[]

  @@unique([phaseId, code])
  @@index([curriculumId, phaseId])
  @@index([phaseId, active])
}

// ─── Assessment (core entity — workspace-scoped, catalog-linked) ──────────────

model Assessment {
  id          String           @id @default(cuid())
  workspaceId String
  title       String
  description String?

  curriculumId   String
  phaseId        String
  gradeId        String
  subjectId      String
  assessmentType AssessmentType
  term           String?
  session        String?

  totalMarks       Int
  weightingPercent Float?
  durationMinutes  Int?

  questionCount       Int?
  pagesPerScript      Int?
  memorandumAvailable Boolean  @default(false)
  rubricAvailable     Boolean  @default(false)
  setupComplete       Boolean  @default(false)
  setupCompletedAt    DateTime?

  assessmentDate      DateTime?
  dueDate             DateTime?
  markingDeadline     DateTime?
  moderationDeadline  DateTime?

  rubricTemplateId String?

  status AssessmentStatus @default(DRAFT)

  creatorTeacherId String
  assignedUserId   String?

  aiMetadata Json?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  workspace        Workspace                   @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  curriculum       Curriculum                  @relation(fields: [curriculumId], references: [id])
  phase            Phase                       @relation(fields: [phaseId], references: [id])
  grade            Grade                       @relation(fields: [gradeId], references: [id])
  subject          Subject                     @relation(fields: [subjectId], references: [id])
  creatorTeacher   User                        @relation("AssessmentCreator", fields: [creatorTeacherId], references: [id])
  assignedUser     User?                       @relation("AssessmentAssignee", fields: [assignedUserId], references: [id])
  moderationAudits    AssessmentModerationAudit[]
  moderationComments  ModerationComment[]
  approvalRequests    ModerationApprovalRequest[]
  intelligenceReport  AssessmentIntelligenceReport?
  markAdjustments     MarkAdjustmentAudit[]
  questions           AssessmentQuestion[]
  generatedVersions   GeneratedAssessment[]
  scriptBatches       ScriptBatch[]
  learnerScripts      LearnerScript[]
  examSessions           ExamSession[]
  rubricTemplate         RubricTemplate?         @relation(fields: [rubricTemplateId], references: [id], onDelete: SetNull)
  learnerAssessmentMarks LearnerAssessmentMark[]
  paperVaultDocuments    PaperVaultDocument[]
  examinationSlots       ExaminationSlot[]
  examinationOpsSessions ExaminationOpsSession[]

  aiBuilderRequest       AiAssessmentBuilderRequest?

  analyticsSnapshot Json?

  resultsPublishRequestedAt DateTime?
  publishedAt               DateTime?

  @@index([workspaceId, status])
  @@index([workspaceId, curriculumId])
  @@index([creatorTeacherId])
  @@index([assignedUserId])
  @@index([workspaceId, assessmentDate])
  @@index([workspaceId, dueDate])
  @@index([rubricTemplateId])
}

model AssessmentModerationAudit {
  id            String           @id @default(cuid())
  assessmentId  String
  action        ModerationAction
  fromStatus    AssessmentStatus
  toStatus      AssessmentStatus
  performedById String
  comment       String?
  createdAt     DateTime         @default(now())

  assessment  Assessment @relation(fields: [assessmentId], references: [id], onDelete: Cascade)
  performedBy User       @relation(fields: [performedById], references: [id])

  @@index([assessmentId, createdAt])
  @@index([performedById])
}

model AssessmentQuestion {
  id             String   @id @default(cuid())
  assessmentId   String
  questionNumber String
  section        String?
  questionText   String
  topic          String?
  marks          Int
  cognitiveLevel String?
  difficulty     String?
  expectedAnswer String?
  memoNotes      String?
  rubricNotes    String?
  orderIndex     Int

  analyticsMetadata Json?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  assessment Assessment @relation(fields: [assessmentId], references: [id], onDelete: Cascade)
  scriptMarks ScriptQuestionMark[]

  @@unique([assessmentId, orderIndex])
  @@index([assessmentId])
  @@index([assessmentId, topic])
  @@index([assessmentId, cognitiveLevel])
  @@index([assessmentId, difficulty])
}

// ─── AI assessment generation foundation ──────────────────────────────────────

model AssessmentGenerationRequest {
  id             String                   @id @default(cuid())
  workspaceId    String
  createdById    String
  curriculumId   String
  phaseId        String
  gradeId        String
  subjectId      String
  assessmentType AssessmentType
  outputMode     GenerationMode
  term           String?
  title          String
  totalMarks     Int
  difficulty     GenerationDifficulty
  instructions   String?
  topics         Json
  status         AssessmentGenerationStatus @default(DRAFT)
  createdAt      DateTime                 @default(now())
  updatedAt      DateTime                 @updatedAt

  workspace  Workspace             @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  createdBy  User                  @relation("GenerationRequestCreator", fields: [createdById], references: [id])
  generated  GeneratedAssessment[]

  @@index([workspaceId, status])
  @@index([createdById, createdAt])
}

model GeneratedAssessment {
  id                  String   @id @default(cuid())
  requestId           String
  assessmentId        String?
  version             Int
  generatedBy         String
  generationMetadata  Json
  createdAt           DateTime @default(now())

  request     AssessmentGenerationRequest @relation(fields: [requestId], references: [id], onDelete: Cascade)
  assessment  Assessment?                 @relation(fields: [assessmentId], references: [id], onDelete: SetNull)
  author      User                        @relation("GeneratedAssessmentAuthor", fields: [generatedBy], references: [id])

  @@unique([requestId, version])
  @@index([requestId, createdAt])
  @@index([assessmentId])
}

// ─── Curriculum topics (topic foundation for AI & analytics) ──────────────────

model CurriculumTopic {
  id           String   @id @default(cuid())
  curriculumId String
  phaseId      String
  gradeId      String
  subjectId    String
  topic        String
  subtopic     String   @default("")
  orderIndex   Int      @default(0)
  active       Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@unique([curriculumId, phaseId, gradeId, subjectId, topic, subtopic])
  @@index([curriculumId, phaseId, gradeId, subjectId, active])
}

// ─── Question bank (reusable questions) ───────────────────────────────────────

model QuestionBankItem {
  id             String             @id @default(cuid())
  workspaceId    String
  curriculumId   String
  phaseId        String
  gradeId        String
  subjectId      String
  topic          String?
  subtopic       String?
  questionText   String
  expectedAnswer String?
  memoNotes      String?
  rubricNotes    String?
  marks          Int
  difficulty     String?
  cognitiveLevel String?
  source         QuestionBankSource
  status         QuestionBankStatus @default(DRAFT)
  createdById    String
  approvedById   String?
  approvedAt     DateTime?
  archivedAt     DateTime?
  usageCount     Int                @default(0)
  firstUsedAt    DateTime?
  lastUsedAt     DateTime?
  metadata       Json?
  createdAt      DateTime           @default(now())
  updatedAt      DateTime           @updatedAt

  workspace  Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  createdBy  User      @relation("QuestionBankCreator", fields: [createdById], references: [id])
  approvedBy User?     @relation("QuestionBankApprover", fields: [approvedById], references: [id])

  @@index([workspaceId, status])
  @@index([workspaceId, curriculumId, subjectId])
  @@index([workspaceId, topic])
  @@index([createdById])
}

// ─── Assessment templates (reusable assessment structures) ────────────────────

model AssessmentTemplate {
  id           String                   @id @default(cuid())
  workspaceId  String
  curriculumId String
  phaseId      String
  gradeId      String
  subjectId    String
  name         String
  description  String?
  createdById  String
  status       AssessmentTemplateStatus @default(ACTIVE)
  createdAt    DateTime                 @default(now())
  updatedAt    DateTime                 @updatedAt

  workspace  Workspace                   @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  createdBy  User                        @relation("TemplateCreator", fields: [createdById], references: [id])
  questions  AssessmentTemplateQuestion[]

  @@index([workspaceId, status])
  @@index([workspaceId, curriculumId, subjectId])
  @@index([createdById])
}

model AssessmentTemplateQuestion {
  id             String @id @default(cuid())
  templateId     String
  questionText   String
  topic          String?
  subtopic       String?
  expectedAnswer String?
  memoNotes      String?
  rubricNotes    String?
  marks          Int
  difficulty     String?
  cognitiveLevel String?
  orderIndex     Int

  template AssessmentTemplate @relation(fields: [templateId], references: [id], onDelete: Cascade)

  @@index([templateId, orderIndex])
}

// ─── Learner scripts & manual marking ───────────────────────────────────────────

model Learner {
  id            String   @id @default(cuid())
  workspaceId   String
  learnerNumber String
  firstName     String
  lastName      String
  gradeId       String
  className     String?
  active        Boolean  @default(true)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  workspace          Workspace           @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  grade              Grade               @relation(fields: [gradeId], references: [id])
  learnerScripts          LearnerScript[]
  examDeviceSessions      ExamDeviceSession[]
  learnerAssessmentMarks  LearnerAssessmentMark[]
  atRiskFlags             LearnerAtRiskFlag[]
  interventions           LearnerIntervention[]
  concessions             LearnerConcession[]
  portalAccount           PortalAccount?
  parentLinks             ParentLearnerLink[]
  seatingAllocations      SeatingAllocation[]
  examinationIncidents    ExaminationIncident[]

  @@unique([workspaceId, learnerNumber])
  @@index([workspaceId, active])
  @@index([gradeId])
}

model ScriptBatch {
  id            String            @id @default(cuid())
  workspaceId   String
  assessmentId  String
  createdById   String
  title         String
  status        ScriptBatchStatus @default(DRAFT)
  totalLearners Int               @default(0)
  totalScripts  Int               @default(0)
  totalPages      Int               @default(0)
  examSessionMode Boolean           @default(false)
  createdAt       DateTime          @default(now())
  updatedAt       DateTime          @updatedAt

  workspace      Workspace       @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  assessment     Assessment      @relation(fields: [assessmentId], references: [id], onDelete: Cascade)
  createdBy      User            @relation("ScriptBatchCreator", fields: [createdById], references: [id])
  learnerScripts LearnerScript[]
  examSessions   ExamSession[]

  @@index([workspaceId, status])
  @@index([assessmentId])
  @@index([createdById])
}

model LearnerScript {
  id               String              @id @default(cuid())
  batchId          String
  learnerId        String
  assessmentId     String
  scriptNumber     String
  pageCount        Int                 @default(0)
  status           LearnerScriptStatus @default(NOT_MARKED)
  teacherTotal     Float?
  hodTotal         Float?
  finalTotal       Float?
  confidence       Float?
  submittedToHodAt   DateTime?
  approvedAt       DateTime?
  teacherLayerLocked Boolean             @default(false)
  hodLayerLocked     Boolean             @default(false)
  finalisedAt                DateTime?
  finalisedById              String?
  markDifference             Float?
  teacherPercentage          Float?
  hodPercentage              Float?
  finalPercentage            Float?
  moderationVariancePercent  Float?
  varianceLevel              ModerationVarianceLevel @default(NONE)
  flaggedForReview           Boolean                 @default(false)
  privateTeacherNotes        String?
  createdAt                  DateTime                @default(now())
  updatedAt                  DateTime                @updatedAt

  batch          ScriptBatch            @relation(fields: [batchId], references: [id], onDelete: Cascade)
  learner        Learner                @relation(fields: [learnerId], references: [id], onDelete: Cascade)
  assessment     Assessment             @relation(fields: [assessmentId], references: [id], onDelete: Cascade)
  finalisedBy    User?                  @relation("ScriptFinaliser", fields: [finalisedById], references: [id])
  questionMarks  ScriptQuestionMark[]
  layers         ScriptAnnotationLayer[]
  feedback       LearnerFeedback[]
  pages                 ScriptPage[]
  learnerAssessmentMark LearnerAssessmentMark?
  rubricMarks           ScriptRubricMark[]

  @@unique([batchId, learnerId])
  @@index([batchId, status])
  @@index([assessmentId])
  @@index([learnerId])
}

model ScriptQuestionMark {
  id                   String   @id @default(cuid())
  learnerScriptId      String
  assessmentQuestionId String
  questionNumber       String
  maxMarks             Int
  teacherMark          Float?
  hodMark              Float?
  finalMark            Float?
  teacherComment       String?
  hodComment           String?
  teacherAnnotatedText String?
  hodAnnotatedText     String?
  teacherMarkedById    String?
  hodModeratedById     String?
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt

  learnerScript      LearnerScript      @relation(fields: [learnerScriptId], references: [id], onDelete: Cascade)
  assessmentQuestion AssessmentQuestion @relation(fields: [assessmentQuestionId], references: [id], onDelete: Cascade)
  teacherMarkedBy    User?              @relation("TeacherMarker", fields: [teacherMarkedById], references: [id])
  hodModeratedBy     User?              @relation("HodModerator", fields: [hodModeratedById], references: [id])

  @@unique([learnerScriptId, assessmentQuestionId])
  @@index([learnerScriptId])
  @@index([assessmentQuestionId])
}

model ScriptPage {
  id              String   @id @default(cuid())
  learnerScriptId String
  pageNumber      Int
  fileName        String
  filePath        String
  mimeType        String
  fileSize        Int
  width           Int?
  height          Int?
  uploadedById    String
  uploadedAt      DateTime @default(now())

  learnerScript LearnerScript @relation(fields: [learnerScriptId], references: [id], onDelete: Cascade)
  uploadedBy    User          @relation("ScriptPageUploader", fields: [uploadedById], references: [id])

  @@unique([learnerScriptId, pageNumber])
  @@index([learnerScriptId])
}

model ScriptAnnotationLayer {
  id              String              @id @default(cuid())
  learnerScriptId String
  layerType       AnnotationLayerType
  color           String
  createdById     String
  annotationData  Json?
  createdAt       DateTime            @default(now())
  updatedAt       DateTime            @updatedAt

  learnerScript LearnerScript @relation(fields: [learnerScriptId], references: [id], onDelete: Cascade)
  createdBy     User          @relation("AnnotationAuthor", fields: [createdById], references: [id])

  @@unique([learnerScriptId, layerType])
  @@index([learnerScriptId])
}

model ExamSession {
  id                String    @id @default(cuid())
  workspaceId       String
  assessmentId      String?
  scriptBatchId     String?
  title             String
  examSessionMode   Boolean   @default(true)
  kioskInstructions String?
  startedAt         DateTime  @default(now())
  endedAt           DateTime?
  createdById       String
  active            Boolean   @default(true)
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  workspace      Workspace           @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  assessment     Assessment?         @relation(fields: [assessmentId], references: [id], onDelete: SetNull)
  scriptBatch    ScriptBatch?        @relation(fields: [scriptBatchId], references: [id], onDelete: SetNull)
  createdBy      User                @relation("ExamSessionCreator", fields: [createdById], references: [id])
  deviceSessions ExamDeviceSession[]

  @@index([workspaceId, active])
  @@index([assessmentId])
  @@index([scriptBatchId])
}

model ExamDeviceSession {
  id            String    @id @default(cuid())
  examSessionId String
  learnerId     String
  deviceId      String
  deviceLabel   String?
  userAgent     String?
  ipAddress     String?
  registeredAt  DateTime  @default(now())
  lastSeenAt    DateTime  @default(now())
  endedAt       DateTime?
  active        Boolean   @default(true)

  examSession ExamSession @relation(fields: [examSessionId], references: [id], onDelete: Cascade)
  learner     Learner     @relation(fields: [learnerId], references: [id], onDelete: Cascade)

  @@index([examSessionId, learnerId, active])
  @@index([examSessionId, active])
  @@index([deviceId])
}

model LearnerFeedback {
  id                String   @id @default(cuid())
  learnerScriptId   String
  teacherFeedback   String?
  hodFeedback       String?
  interventionNotes String?
  createdById       String
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  learnerScript LearnerScript @relation(fields: [learnerScriptId], references: [id], onDelete: Cascade)
  createdBy     User          @relation("FeedbackAuthor", fields: [createdById], references: [id])

  @@index([learnerScriptId, createdAt])
  @@index([createdById])
}

// ─── Workspace subject offerings (school-managed) ─────────────────────────────

model WorkspaceSubject {
  id               String    @id @default(cuid())
  workspaceId      String
  name             String
  code             String
  curriculumId     String
  phaseId          String
  gradeId          String
  catalogSubjectId String?
  department       String?
  active           Boolean   @default(true)
  archivedAt       DateTime?
  createdById      String
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  workspace      Workspace   @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  curriculum     Curriculum  @relation(fields: [curriculumId], references: [id])
  phase          Phase       @relation(fields: [phaseId], references: [id])
  grade          Grade       @relation(fields: [gradeId], references: [id])
  catalogSubject        Subject?              @relation(fields: [catalogSubjectId], references: [id], onDelete: SetNull)
  createdBy             User                  @relation("WorkspaceSubjectCreator", fields: [createdById], references: [id])
  teacherAssignments    TeacherAssignment[]
  subjectRequirements   SubjectRequirement[]
  lessonEntries         LessonEntry[]

  @@unique([workspaceId, code])
  @@index([workspaceId, active])
  @@index([workspaceId, department])
  @@index([workspaceId, gradeId])
}

// ─── Rubric templates (structured marking criteria) ───────────────────────────

model RubricTemplate {
  id           String               @id @default(cuid())
  workspaceId  String
  name         String
  description  String?
  subjectId    String?
  scope        RubricTemplateScope
  status       RubricTemplateStatus @default(DRAFT)
  totalMarks   Int                  @default(0)
  createdById  String
  approvedById String?
  approvedAt   DateTime?
  archivedAt   DateTime?
  createdAt    DateTime             @default(now())
  updatedAt    DateTime             @updatedAt

  workspace  Workspace        @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  subject    Subject?         @relation(fields: [subjectId], references: [id], onDelete: SetNull)
  createdBy  User             @relation("RubricTemplateCreator", fields: [createdById], references: [id])
  approvedBy User?            @relation("RubricTemplateApprover", fields: [approvedById], references: [id])
  criteria   RubricCriterion[]
  assessments Assessment[]

  @@index([workspaceId, status])
  @@index([workspaceId, subjectId])
  @@index([createdById])
}

model RubricCriterion {
  id               String @id @default(cuid())
  rubricTemplateId String
  name             String
  description      String?
  maxMarks         Int
  orderIndex       Int

  template    RubricTemplate    @relation(fields: [rubricTemplateId], references: [id], onDelete: Cascade)
  scriptMarks ScriptRubricMark[]

  @@unique([rubricTemplateId, orderIndex])
  @@index([rubricTemplateId])
}

model ScriptRubricMark {
  id                String   @id @default(cuid())
  learnerScriptId   String
  rubricCriterionId String
  teacherMark       Float?
  hodMark           Float?
  finalMark         Float?
  teacherComment    String?
  hodComment        String?
  teacherMarkedById String?
  hodModeratedById  String?
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  learnerScript   LearnerScript   @relation(fields: [learnerScriptId], references: [id], onDelete: Cascade)
  rubricCriterion RubricCriterion @relation(fields: [rubricCriterionId], references: [id], onDelete: Cascade)
  teacherMarkedBy User?           @relation("RubricTeacherMarker", fields: [teacherMarkedById], references: [id])
  hodModeratedBy  User?           @relation("RubricHodModerator", fields: [hodModeratedById], references: [id])

  @@unique([learnerScriptId, rubricCriterionId])
  @@index([learnerScriptId])
}

// ─── One-time mark capture (canonical learner marks) ──────────────────────────

model LearnerAssessmentMark {
  id              String            @id @default(cuid())
  workspaceId     String
  assessmentId    String
  learnerId       String
  learnerScriptId String?           @unique
  teacherMark     Float?
  hodMark         Float?
  finalMark       Float?
  finalPercentage Float?
  comment         String?
  source          MarkCaptureSource @default(SCRIPT_MARKING)
  capturedAt      DateTime          @default(now())
  capturedById    String
  updatedAt       DateTime          @updatedAt

  workspace     Workspace      @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  assessment    Assessment     @relation(fields: [assessmentId], references: [id], onDelete: Cascade)
  learner       Learner        @relation(fields: [learnerId], references: [id], onDelete: Cascade)
  learnerScript LearnerScript? @relation(fields: [learnerScriptId], references: [id], onDelete: SetNull)
  capturedBy    User           @relation("MarkCaptureAuthor", fields: [capturedById], references: [id])

  @@unique([assessmentId, learnerId])
  @@index([workspaceId, assessmentId])
  @@index([learnerId, assessmentId])
  @@index([assessmentId, finalMark])
}

model LearnerAtRiskFlag {
  id          String       @id @default(cuid())
  workspaceId String
  learnerId   String
  reason      AtRiskReason
  active      Boolean      @default(true)
  metadata    Json?
  flaggedAt   DateTime     @default(now())
  clearedAt   DateTime?

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  learner   Learner   @relation(fields: [learnerId], references: [id], onDelete: Cascade)

  @@index([workspaceId, active])
  @@index([learnerId, active])
  @@index([workspaceId, learnerId, reason, active])
}

model LearnerIntervention {
  id                String             @id @default(cuid())
  workspaceId       String
  learnerId         String
  riskReason        AtRiskReason
  dateFlagged       DateTime
  teacherNotes      String?
  parentMeetingDate DateTime?
  interventionNotes String?
  reviewDate        DateTime?
  status            InterventionStatus @default(OPEN)
  createdById       String
  updatedById       String?
  createdAt         DateTime           @default(now())
  updatedAt         DateTime           @updatedAt

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  learner   Learner   @relation(fields: [learnerId], references: [id], onDelete: Cascade)
  createdBy User      @relation("InterventionCreator", fields: [createdById], references: [id])
  updatedBy User?     @relation("InterventionUpdater", fields: [updatedById], references: [id])

  @@index([workspaceId, status])
  @@index([learnerId, status])
  @@index([workspaceId, learnerId])
}

model ExamReadinessSnapshot {
  id                  String              @id @default(cuid())
  workspaceId         String
  scope               ExamReadinessScope  @default(SCHOOL)
  department          String?
  gradeId             String?
  subjectId           String?
  readinessPercentage Float
  status              ExamReadinessStatus
  components          Json
  calculatedAt        DateTime            @default(now())

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  grade     Grade?    @relation(fields: [gradeId], references: [id], onDelete: SetNull)
  subject   Subject?  @relation(fields: [subjectId], references: [id], onDelete: SetNull)

  @@index([workspaceId, scope, calculatedAt])
  @@index([workspaceId, department])
  @@index([workspaceId, gradeId])
  @@index([workspaceId, subjectId])
}

// ─── Examination operations (Phase 6) ─────────────────────────────────────────

model ExamVenue {
  id          String   @id @default(cuid())
  workspaceId String
  name        String
  location    String?
  capacity    Int
  rows        Int      @default(10)
  columns     Int      @default(8)
  active      Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  workspace              Workspace               @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  examinationSlots       ExaminationSlot[]
  examinationOpsSessions ExaminationOpsSession[]
  invigilatorAssignments InvigilatorAssignment[]
  seatingPlans           SeatingPlan[]
  examinationIncidents   ExaminationIncident[]

  @@index([workspaceId, active])
}

model ExaminationTimetable {
  id          String   @id @default(cuid())
  workspaceId String
  title       String
  description String?
  gradeId     String?
  subjectId   String?
  startDate   DateTime
  endDate     DateTime
  active      Boolean  @default(true)
  createdById String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  grade     Grade?    @relation(fields: [gradeId], references: [id], onDelete: SetNull)
  subject   Subject?  @relation(fields: [subjectId], references: [id], onDelete: SetNull)
  createdBy User      @relation("ExamTimetableCreator", fields: [createdById], references: [id])
  slots     ExaminationSlot[]

  @@index([workspaceId, startDate, endDate])
}

model ExaminationSlot {
  id              String   @id @default(cuid())
  workspaceId     String
  timetableId     String?
  title           String
  gradeId         String?
  subjectId       String?
  assessmentId    String?
  venueId         String?
  startTime       DateTime
  endTime         DateTime
  durationMinutes Int
  notes           String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  workspace   Workspace             @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  timetable   ExaminationTimetable? @relation(fields: [timetableId], references: [id], onDelete: SetNull)
  grade       Grade?                @relation(fields: [gradeId], references: [id], onDelete: SetNull)
  subject     Subject?              @relation(fields: [subjectId], references: [id], onDelete: SetNull)
  assessment  Assessment?           @relation(fields: [assessmentId], references: [id], onDelete: SetNull)
  venue       ExamVenue?            @relation(fields: [venueId], references: [id], onDelete: SetNull)
  opsSession  ExaminationOpsSession?

  @@index([workspaceId, startTime, endTime])
  @@index([venueId, startTime])
  @@index([gradeId, startTime])
  @@index([timetableId])
}

model ExaminationOpsSession {
  id              String                      @id @default(cuid())
  workspaceId     String
  slotId          String?                     @unique
  title           String
  gradeId         String?
  subjectId       String?
  assessmentId    String?
  venueId         String?
  scheduledStart  DateTime
  scheduledEnd    DateTime
  actualStart     DateTime?
  actualEnd       DateTime?
  status          ExaminationOpsSessionStatus @default(SCHEDULED)
  durationMinutes Int
  learnerCount    Int                         @default(0)
  notes           String?
  createdById     String
  createdAt       DateTime                    @default(now())
  updatedAt       DateTime                    @updatedAt

  workspace              Workspace               @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  slot                   ExaminationSlot?        @relation(fields: [slotId], references: [id], onDelete: SetNull)
  grade                  Grade?                  @relation(fields: [gradeId], references: [id], onDelete: SetNull)
  subject                Subject?                @relation(fields: [subjectId], references: [id], onDelete: SetNull)
  assessment             Assessment?             @relation(fields: [assessmentId], references: [id], onDelete: SetNull)
  venue                  ExamVenue?              @relation(fields: [venueId], references: [id], onDelete: SetNull)
  createdBy              User                    @relation("ExamOpsSessionCreator", fields: [createdById], references: [id])
  invigilatorAssignments InvigilatorAssignment[]
  seatingPlans           SeatingPlan[]
  examinationIncidents   ExaminationIncident[]

  @@index([workspaceId, status])
  @@index([workspaceId, scheduledStart])
  @@index([venueId])
}

model InvigilatorAssignment {
  id           String   @id @default(cuid())
  workspaceId  String
  sessionId    String
  userId       String
  venueId      String?
  isLead       Boolean  @default(false)
  assignedById String
  assignedAt   DateTime @default(now())

  workspace  Workspace             @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  session    ExaminationOpsSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  user       User                  @relation("InvigilatorUser", fields: [userId], references: [id])
  venue      ExamVenue?            @relation(fields: [venueId], references: [id], onDelete: SetNull)
  assignedBy User                  @relation("InvigilatorAssigner", fields: [assignedById], references: [id])

  @@unique([sessionId, userId])
  @@index([workspaceId, userId])
  @@index([sessionId])
}

model SeatingPlan {
  id          String   @id @default(cuid())
  workspaceId String
  sessionId   String
  venueId     String
  rows        Int
  columns     Int
  generatedAt DateTime @default(now())
  createdById String

  workspace   Workspace             @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  session     ExaminationOpsSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  venue       ExamVenue             @relation(fields: [venueId], references: [id])
  createdBy   User                  @relation("SeatingPlanCreator", fields: [createdById], references: [id])
  allocations SeatingAllocation[]

  @@index([sessionId])
}

model SeatingAllocation {
  id            String @id @default(cuid())
  seatingPlanId String
  learnerId     String
  row           Int
  column        Int
  seatLabel     String

  seatingPlan SeatingPlan @relation(fields: [seatingPlanId], references: [id], onDelete: Cascade)
  learner     Learner     @relation(fields: [learnerId], references: [id], onDelete: Cascade)

  @@unique([seatingPlanId, learnerId])
  @@unique([seatingPlanId, row, column])
}

model ExaminationIncident {
  id              String                    @id @default(cuid())
  workspaceId     String
  sessionId       String?
  learnerId       String?
  venueId         String?
  incidentType    ExaminationIncidentType
  description     String
  status          ExaminationIncidentStatus @default(OPEN)
  reportedAt      DateTime                  @default(now())
  resolutionNotes String?
  closedAt        DateTime?
  reportedById    String
  createdAt       DateTime                  @default(now())
  updatedAt       DateTime                  @updatedAt

  workspace  Workspace              @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  session    ExaminationOpsSession? @relation(fields: [sessionId], references: [id], onDelete: SetNull)
  learner    Learner?               @relation(fields: [learnerId], references: [id], onDelete: SetNull)
  venue      ExamVenue?             @relation(fields: [venueId], references: [id], onDelete: SetNull)
  reportedBy User                   @relation("IncidentReporter", fields: [reportedById], references: [id])

  @@index([workspaceId, status])
  @@index([sessionId])
}

// ─── Secure examination paper vault ───────────────────────────────────────────

model PaperVaultDocument {
  id               String            @id @default(cuid())
  workspaceId      String
  assessmentId     String
  documentGroupId  String
  documentType     PaperDocumentType
  versionNumber    Int
  fileName         String
  storedPath       String
  mimeType         String
  fileSize         Int
  status           PaperVaultStatus  @default(DRAFT)
  isCurrentVersion Boolean           @default(true)
  uploadedById     String
  releaseAt        DateTime?
  expiresAt        DateTime?
  workflowComment  String?
  archivedAt       DateTime?
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt

  workspace   Workspace  @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  assessment  Assessment @relation(fields: [assessmentId], references: [id], onDelete: Cascade)
  uploadedBy  User       @relation("PaperVaultUploader", fields: [uploadedById], references: [id])

  @@unique([documentGroupId, versionNumber])
  @@index([workspaceId, assessmentId])
  @@index([assessmentId, status])
  @@index([documentGroupId, isCurrentVersion])
  @@index([uploadedById])
}

// ─── Learner concessions register ─────────────────────────────────────────────

model LearnerConcession {
  id            String         @id @default(cuid())
  workspaceId   String
  learnerId     String
  concessionType ConcessionType
  description   String?
  effectiveDate DateTime
  expiryDate    DateTime?
  active        Boolean        @default(true)
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  learner   Learner   @relation(fields: [learnerId], references: [id], onDelete: Cascade)

  @@index([workspaceId, active])
  @@index([learnerId, active])
  @@index([workspaceId, learnerId, active])
}

// ─── Parent & learner academic progress portal ────────────────────────────────

model PortalAccount {
  id          String         @id @default(cuid())
  workspaceId String
  type        PortalUserType
  email       String?
  fullName    String?
  learnerId   String?        @unique
  isActive    Boolean        @default(true)
  lastLoginAt DateTime?
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt

  workspace   Workspace            @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  learner     Learner?             @relation(fields: [learnerId], references: [id], onDelete: Cascade)
  parentLinks ParentLearnerLink[]  @relation("ParentAccount")

  @@unique([workspaceId, email])
  @@index([workspaceId, type, isActive])
}

model ParentLearnerLink {
  id              String   @id @default(cuid())
  workspaceId     String
  parentAccountId String
  learnerId       String
  createdAt       DateTime @default(now())

  workspace     Workspace     @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  parentAccount PortalAccount @relation("ParentAccount", fields: [parentAccountId], references: [id], onDelete: Cascade)
  learner       Learner       @relation(fields: [learnerId], references: [id], onDelete: Cascade)

  @@unique([parentAccountId, learnerId])
  @@index([workspaceId, learnerId])
  @@index([parentAccountId])
}

model PortalOtp {
  id          String         @id @default(cuid())
  workspaceId String
  identifier  String
  portalType  PortalUserType
  code        String
  expiresAt   DateTime
  usedAt      DateTime?
  createdAt   DateTime       @default(now())

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@index([workspaceId, identifier, portalType, expiresAt])
}

// ─── AI Assessment Builder (material upload → generate → approve) ─────────────

model AiAssessmentBuilderRequest {
  id              String            @id @default(cuid())
  workspaceId     String
  createdById     String
  status          AiBuilderStatus   @default(UPLOADING)

  curriculumId    String?
  phaseId         String?
  gradeId         String?
  subjectId       String?
  assessmentType  AssessmentType?
  title           String?
  term            String?
  totalMarks      Int?
  durationMinutes Int?
  difficulty      AiBuilderDifficulty?
  questionTypes   AiQuestionType[]     @default([])
  bloomLevels     AiBloomLevel[]       @default([])
  instructions    String?

  draftMetadata   Json?
  qualityChecks   Json?

  sourceMode              AiBuilderSourceMode @default(STUDY_MATERIAL)
  selectedQuestionBankIds Json?
  frameworkText           String?
  frameworkRequired       Boolean             @default(false)
  frameworkDetected       Boolean             @default(false)

  assessmentId    String?           @unique

  createdAt       DateTime          @default(now())
  updatedAt       DateTime          @updatedAt

  workspace   Workspace         @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  createdBy   User              @relation("AiBuilderCreator", fields: [createdById], references: [id])
  assessment  Assessment?       @relation(fields: [assessmentId], references: [id], onDelete: SetNull)
  materials   AiStudyMaterial[]

  @@index([workspaceId, status])
  @@index([createdById, createdAt])
}

model AiStudyMaterial {
  id               String             @id @default(cuid())
  requestId        String
  workspaceId      String

  fileType         AiMaterialType
  fileName         String
  storedKey        String
  mimeType         String
  fileSize         Int

  uploadPurpose      AiUploadPurpose    @default(STUDY_MATERIAL)
  extractionStatus   AiExtractionStatus @default(PENDING)
  extractedText      String?
  manualText         String?
  ocrAttempted       Boolean            @default(false)
  ocrConfidence      Float?
  reviewConfirmed    Boolean            @default(false)
  extractedQuestions Json?
  duplicateWarnings  Json?

  uploadedById     String
  createdAt        DateTime           @default(now())
  updatedAt        DateTime           @updatedAt

  request    AiAssessmentBuilderRequest @relation(fields: [requestId], references: [id], onDelete: Cascade)
  uploadedBy User                       @relation("AiMaterialUploader", fields: [uploadedById], references: [id])

  @@index([requestId])
  @@index([workspaceId])
}

// ─── Phase 2: Configurable workflow ───────────────────────────────────────────

model WorkspaceWorkflowConfig {
  id          String   @id @default(cuid())
  workspaceId String   @unique
  stages      Json
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
}

// ─── Phase 2: Mark adjustment audit trail ─────────────────────────────────────

model MarkAdjustmentAudit {
  id                 String            @id @default(cuid())
  workspaceId        String
  assessmentId       String
  learnerScriptId    String?
  learnerId          String?
  questionMarkId     String?
  field              String
  previousValue      Float?
  newValue           Float?
  reason             String?
  adjustedById       String
  source             MarkCaptureSource @default(SCRIPT_MARKING)
  createdAt          DateTime          @default(now())

  workspace    Workspace   @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  assessment   Assessment  @relation(fields: [assessmentId], references: [id], onDelete: Cascade)
  adjustedBy   User        @relation("MarkAdjustmentAuthor", fields: [adjustedById], references: [id])

  @@index([assessmentId, createdAt])
  @@index([learnerScriptId, createdAt])
  @@index([workspaceId, createdAt])
}

// ─── Phase 2: Moderation trail ────────────────────────────────────────────────

model ModerationComment {
  id           String                @id @default(cuid())
  assessmentId String
  authorId     String
  body         String
  type         ModerationCommentType @default(COMMENT)
  resolved     Boolean               @default(false)
  parentId     String?
  createdAt    DateTime              @default(now())
  updatedAt    DateTime              @updatedAt

  assessment Assessment         @relation(fields: [assessmentId], references: [id], onDelete: Cascade)
  author     User               @relation("ModerationCommentAuthor", fields: [authorId], references: [id])
  parent     ModerationComment? @relation("CommentThread", fields: [parentId], references: [id], onDelete: SetNull)
  replies    ModerationComment[] @relation("CommentThread")

  @@index([assessmentId, createdAt])
  @@index([authorId])
}

model ModerationApprovalRequest {
  id            String                @id @default(cuid())
  assessmentId  String
  requestedById String
  assignedRole  WorkspaceRole
  status        ApprovalRequestStatus @default(PENDING)
  comment       String?
  respondedById String?
  respondedAt   DateTime?
  createdAt     DateTime              @default(now())
  updatedAt     DateTime              @updatedAt

  assessment  Assessment @relation(fields: [assessmentId], references: [id], onDelete: Cascade)
  requestedBy User       @relation("ApprovalRequestCreator", fields: [requestedById], references: [id])
  respondedBy User?      @relation("ApprovalRequestResponder", fields: [respondedById], references: [id])

  @@index([assessmentId, status])
  @@index([requestedById])
}

// ─── Phase 2: ScriptCheck Intelligence ────────────────────────────────────────

model AssessmentIntelligenceReport {
  id                 String   @id @default(cuid())
  assessmentId       String   @unique
  complianceScore    Float
  capsCompliance     Float
  cognitiveBalance   Float
  missingRubrics     Boolean  @default(false)
  missingMemorandums Boolean  @default(false)
  riskIndicators     Json
  recommendations    Json
  generatedAt        DateTime @default(now())
  generatedById      String?

  assessment  Assessment @relation(fields: [assessmentId], references: [id], onDelete: Cascade)
  generatedBy User?      @relation("IntelligenceGenerator", fields: [generatedById], references: [id])

  @@index([assessmentId])
}

// ─── Beta testing feedback (HOD beta programme) ───────────────────────────────

enum BetaFeedbackCategory {
  BUG_REPORT
  WORKFLOW_ISSUE
  SUGGESTION
  FEATURE_REQUEST
  CONFUSING_SCREEN
}

enum BetaFeedbackSeverity {
  CRITICAL
  HIGH
  MEDIUM
  LOW
}

enum BetaFeedbackStatus {
  NEW
  REVIEWING
  IN_PROGRESS
  FIXED
  REJECTED
}

model BetaFeedback {
  id             String               @id @default(cuid())
  workspaceId    String
  userId         String
  userName       String
  userRole       String
  subject        String
  page           String
  category       BetaFeedbackCategory
  severity       BetaFeedbackSeverity
  comment        String
  screenshotPath String?
  status         BetaFeedbackStatus   @default(NEW)
  createdAt      DateTime             @default(now())
  updatedAt      DateTime             @updatedAt

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  user      User      @relation("BetaFeedbackAuthor", fields: [userId], references: [id])

  @@index([workspaceId, createdAt])
  @@index([workspaceId, status])
  @@index([userId])
}

// ─── School timetable foundation (Phase 1) ────────────────────────────────────

enum TimetableRoomType {
  CLASSROOM
  LAB
  COMPUTER_LAB
  HALL
  SPORTS
  OTHER
}

enum PeriodType {
  TEACHING
  BREAK
}

model SchoolClass {
  id           String   @id @default(cuid())
  workspaceId  String
  name         String
  code         String
  grade        String
  learnerCount Int      @default(0)
  active       Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  workspace           Workspace            @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  teacherAssignments  TeacherAssignment[]
  subjectRequirements SubjectRequirement[]
  lessonEntries       LessonEntry[]

  @@unique([workspaceId, code])
  @@index([workspaceId, active])
  @@index([workspaceId, grade])
}

model TimetableRoom {
  id          String            @id @default(cuid())
  workspaceId String
  name        String
  code        String
  roomType    TimetableRoomType @default(CLASSROOM)
  capacity    Int
  active      Boolean           @default(true)
  createdAt   DateTime          @default(now())
  updatedAt   DateTime          @updatedAt

  workspace     Workspace     @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  lessonEntries LessonEntry[]

  @@unique([workspaceId, code])
  @@index([workspaceId, active])
  @@index([workspaceId, roomType])
}

model SchoolDayTemplate {
  id          String   @id @default(cuid())
  workspaceId String
  name        String
  isDefault   Boolean  @default(false)
  active      Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  workspace        Workspace          @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  periods          PeriodDefinition[]
  lessonTimetables LessonTimetable[]

  @@index([workspaceId, active])
  @@index([workspaceId, isDefault])
}

model PeriodDefinition {
  id                   String     @id @default(cuid())
  workspaceId          String
  dayTemplateId        String
  periodOrder          Int
  label                String
  startTime            String
  endTime              String
  periodType           PeriodType @default(TEACHING)
  doublePeriodCapable  Boolean    @default(false)
  createdAt            DateTime   @default(now())
  updatedAt            DateTime   @updatedAt

  workspace     Workspace         @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  dayTemplate   SchoolDayTemplate @relation(fields: [dayTemplateId], references: [id], onDelete: Cascade)
  lessonEntries LessonEntry[]

  @@unique([dayTemplateId, periodOrder])
  @@index([workspaceId, dayTemplateId])
}

model TeacherAssignment {
  id          String   @id @default(cuid())
  workspaceId String
  teacherId   String
  classId     String
  subjectId   String
  active      Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  workspace Workspace        @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  teacher   User             @relation("TimetableTeacher", fields: [teacherId], references: [id])
  class     SchoolClass      @relation(fields: [classId], references: [id], onDelete: Cascade)
  subject   WorkspaceSubject @relation(fields: [subjectId], references: [id], onDelete: Cascade)

  @@unique([workspaceId, teacherId, classId, subjectId])
  @@index([workspaceId, active])
  @@index([workspaceId, classId])
  @@index([workspaceId, teacherId])
}

model SubjectRequirement {
  id                    String   @id @default(cuid())
  workspaceId           String
  classId               String
  subjectId             String
  periodsPerWeek        Int
  doublePeriodsRequired Int      @default(0)
  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt

  workspace Workspace        @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  class     SchoolClass      @relation(fields: [classId], references: [id], onDelete: Cascade)
  subject   WorkspaceSubject @relation(fields: [subjectId], references: [id], onDelete: Cascade)

  @@unique([workspaceId, classId, subjectId])
  @@index([workspaceId, classId])
}

// ─── School lesson timetable builder (Phase 2) ────────────────────────────────

enum LessonTimetableStatus {
  DRAFT
  PUBLISHED
  ARCHIVED
}

enum DayOfWeek {
  MONDAY
  TUESDAY
  WEDNESDAY
  THURSDAY
  FRIDAY
}

model LessonTimetable {
  id            String                @id @default(cuid())
  workspaceId   String
  title         String
  academicYear  String
  term          String
  status        LessonTimetableStatus @default(DRAFT)
  templateId    String
  publishedAt   DateTime?
  publishedById String?
  createdAt     DateTime              @default(now())
  updatedAt     DateTime              @updatedAt

  workspace   Workspace         @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  template    SchoolDayTemplate @relation(fields: [templateId], references: [id])
  publishedBy User?             @relation("LessonTimetablePublisher", fields: [publishedById], references: [id])
  entries     LessonEntry[]

  @@index([workspaceId, status])
  @@index([workspaceId, academicYear, term])
}

model LessonEntry {
  id             String    @id @default(cuid())
  workspaceId    String
  timetableId    String
  dayOfWeek      DayOfWeek
  periodId       String
  schoolClassId  String
  subjectId      String
  teacherUserId  String
  roomId         String?
  isDoublePeriod Boolean   @default(false)
  locked         Boolean   @default(false)
  notes          String?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  workspace   Workspace        @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  timetable   LessonTimetable  @relation(fields: [timetableId], references: [id], onDelete: Cascade)
  period      PeriodDefinition @relation(fields: [periodId], references: [id])
  schoolClass SchoolClass      @relation(fields: [schoolClassId], references: [id], onDelete: Cascade)
  subject     WorkspaceSubject @relation(fields: [subjectId], references: [id], onDelete: Cascade)
  teacher     User             @relation("LessonEntryTeacher", fields: [teacherUserId], references: [id])
  room        TimetableRoom?   @relation(fields: [roomId], references: [id], onDelete: SetNull)

  @@unique([timetableId, dayOfWeek, periodId, schoolClassId])
  @@index([workspaceId, timetableId])
  @@index([timetableId, dayOfWeek, periodId])
  @@index([timetableId, teacherUserId])
  @@index([timetableId, roomId])
  @@index([timetableId, schoolClassId])
}
