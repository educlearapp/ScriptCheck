generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ─── Workspace types ──────────────────────────────────────────────────────────

enum WorkspaceType {
  INDIVIDUAL_EDUCATOR
  SCHOOL
  EXAMINATION_BODY
}

enum WorkspaceRole {
  TEACHER
  HOD
  MODERATOR
  EXAMINATION_OFFICER
  PRINCIPAL
  SCHOOL_ADMIN
  EXAM_BODY_ADMIN
}

enum AuditAction {
  USER_REGISTERED
  WORKSPACE_CREATED
  USER_INVITED
  ROLE_ASSIGNED
  ROLE_REMOVED
  LOGIN
  LOGOUT
  PERMISSION_ACTION
  ASSESSMENT_GENERATION_REQUESTED
  ASSESSMENT_GENERATED
  ASSESSMENT_APPROVED
  ASSESSMENT_REGENERATED
  QUESTION_BANK_ITEM_CREATED
  QUESTION_BANK_ITEM_APPROVED
  QUESTION_BANK_ITEM_ARCHIVED
  QUESTION_BANK_SAVED_FROM_ASSESSMENT
  CURRICULUM_TOPIC_CREATED
  QUESTION_BANK_ITEM_USED
  ASSESSMENT_TEMPLATE_CREATED
  ASSESSMENT_TEMPLATE_USED
  ASSESSMENT_TEMPLATE_ARCHIVED
  SCRIPT_BATCH_CREATED
  LEARNER_SCRIPT_CREATED
  SCRIPT_MARK_SAVED
  SCRIPT_MARKED_COMPLETE
  SCRIPT_BATCH_SUBMITTED_TO_HOD
  SCRIPT_BATCH_APPROVED
  SCRIPT_BATCH_RETURNED
  RESULTS_PUBLISH_REQUESTED
  RESULTS_PUBLISHED
  RESULTS_REOPENED
  LEARNER_FEEDBACK_CREATED
  ASSESSMENT_REPORT_GENERATED
  LEARNER_REPORT_GENERATED
  SCRIPT_PAGE_UPLOADED
  SCRIPT_ANNOTATION_CREATED
  SCRIPT_ANNOTATION_UPDATED
  SCRIPT_STATUS_CHANGED
  SCRIPT_LAYER_LOCKED
  SCRIPT_LAYER_UNLOCKED
  SCRIPT_FINALISED
  EXAM_SESSION_STARTED
  EXAM_DEVICE_REGISTERED
  EXAM_DEVICE_SESSION_ENDED
  SCRIPT_MARK_CAPTURED
  SCRIPT_MARK_UPDATED
  SCRIPT_VARIANCE_FLAGGED
  ASSESSMENT_CREATED
  ASSESSMENT_UPDATED
  SUBJECT_CREATED
  SUBJECT_UPDATED
  SUBJECT_ARCHIVED
  RUBRIC_CREATED
  RUBRIC_UPDATED
  RUBRIC_APPROVED
  ANALYSIS_GENERATED
  LEARNER_FLAGGED_AT_RISK
  RUBRIC_MARK_CAPTURED
  PAPER_UPLOADED
  PAPER_UPDATED
  PAPER_SUBMITTED_FOR_REVIEW
  PAPER_RETURNED_FOR_CHANGES
  PAPER_APPROVED
  PAPER_LOCKED
  PAPER_RELEASED
  PAPER_ARCHIVED
  PAPER_DOWNLOADED
  PAPER_DOWNLOAD_BLOCKED
  BULK_MARK_IMPORT_STARTED
  BULK_MARK_IMPORT_COMPLETED
  BULK_MARK_IMPORT_FAILED
  BULK_MARK_CAPTURED
  PORTAL_LOGIN
  PORTAL_LOGOUT
  PORTAL_REPORT_DOWNLOADED
  PORTAL_ACCESS_DENIED
  EXAM_READINESS_GENERATED
  INTERVENTION_CREATED
  INTERVENTION_UPDATED
  EXECUTIVE_REPORT_GENERATED
  PRINCIPAL_DASHBOARD_VIEWED
  HOD_DASHBOARD_VIEWED
  EXAM_CREATED
  EXAM_UPDATED
  EXAM_COMPLETED
  INVIGILATOR_ASSIGNED
  MODERATION_COMPLETED
  MODERATION_VARIANCE_GENERATED
  SEATING_PLAN_GENERATED
  EXAM_PACK_GENERATED
  EXAM_INCIDENT_CREATED
  EXAM_REPORT_GENERATED
}

enum ModerationVarianceLevel {
  NONE
  OK
  WARNING
  SIGNIFICANT
  CRITICAL
}

enum QuestionBankSource {
  AI_GENERATED
  TEACHER_CREATED
  HOD_APPROVED
  EXAM_BODY
}

enum QuestionBankStatus {
  DRAFT
  APPROVED
  ARCHIVED
}

enum AssessmentTemplateStatus {
  ACTIVE
  ARCHIVED
}

enum ScriptBatchStatus {
  DRAFT
  MARKING
  TEACHER_REVIEW
  SUBMITTED_TO_HOD
  HOD_REVIEW
  RETURNED_TO_TEACHER
  APPROVED
  PUBLISHED
}

enum LearnerScriptStatus {
  NOT_MARKED
  IN_PROGRESS
  UPLOADED
  MARKING
  MARKED
  SUBMITTED_TO_HOD
  HOD_REVIEW
  MODERATION
  RETURNED_TO_TEACHER
  APPROVED
  MODERATED
  FINALISED
}

enum AnnotationLayerType {
  ORIGINAL
  TEACHER_RED
  HOD_GREEN
  FINAL
}

enum AssessmentGenerationStatus {
  DRAFT
  GENERATING
  GENERATED
  FAILED
}

enum GenerationMode {
  QUESTIONS_ONLY
  QUESTIONS_AND_MEMO
  FULL_PACKAGE
}

enum GenerationDifficulty {
  EASY
  STANDARD
  CHALLENGING
}

// ─── Assessment enums ─────────────────────────────────────────────────────────

enum AssessmentStatus {
  DRAFT
  SUBMITTED_TO_HOD
  RETURNED_TO_TEACHER
  AI_REVIEW
  HOD_REVIEW
  APPROVED
  WRITTEN
  MARKING
  MARKED
  PUBLISHED
}

enum ModerationAction {
  SUBMIT_TO_HOD
  APPROVE
  RETURN_TO_TEACHER
}

enum AssessmentType {
  TEST
  EXAM
  ASSIGNMENT
  SBA_TASK
  PROJECT
  PRACTICAL
  ORAL
  OTHER
}

enum RubricTemplateStatus {
  DRAFT
  PENDING_APPROVAL
  APPROVED
  ARCHIVED
}

enum RubricTemplateScope {
  REUSABLE
  SUBJECT_SPECIFIC
  TEACHER_CREATED
}

enum MarkCaptureSource {
  SCRIPT_MARKING
  RUBRIC_MARKING
  MANUAL
  IMPORT
}

enum ConcessionType {
  EXTRA_TIME
  READER
  SCRIBE
  ENLARGED_PAPER
  SEPARATE_VENUE
  ASSISTIVE_TECHNOLOGY
  OTHER
}

enum PortalUserType {
  PARENT
  LEARNER
}

enum AtRiskReason {
  BELOW_THRESHOLD
  CONSECUTIVE_DECLINE
  MULTIPLE_FAILURES
}

enum InterventionStatus {
  OPEN
  IN_PROGRESS
  IMPROVED
  ESCALATED
  CLOSED
}

enum ExamReadinessStatus {
  READY
  ATTENTION_REQUIRED
}

enum ExamReadinessScope {
  SCHOOL
  DEPARTMENT
  GRADE
  SUBJECT
}

enum ExaminationOpsSessionStatus {
  SCHEDULED
  READY
  IN_PROGRESS
  COMPLETED
  ARCHIVED
}

enum ExaminationIncidentStatus {
  OPEN
  UNDER_REVIEW
  CLOSED
}

enum ExaminationIncidentType {
  CANDIDATE_MISCONDUCT
  ABSENTEEISM
  LATE_ARRIVAL
  PAPER_IRREGULARITY
  VENUE_INCIDENT
}

enum PaperDocumentType {
  QUESTION_PAPER
  MEMORANDUM
  MARKING_GUIDELINE
  RUBRIC_ATTACHMENT
  SUPPORTING_MATERIAL
}

enum PaperVaultStatus {
  DRAFT
  PENDING_REVIEW
  APPROVED
  LOCKED
  RELEASED
  ARCHIVED
}

// ─── Workspace (organisation) ─────────────────────────────────────────────────

model Workspace {
  id        String        @id @default(cuid())
  name      String
  slug      String        @unique
  type      WorkspaceType
  email     String?
  phone     String?
  address   String?
  logoUrl   String?
  createdAt DateTime      @default(now())
  updatedAt DateTime      @updatedAt

  memberships                  WorkspaceMembership[]
  assessments                  Assessment[]
  auditLogs                    AuditLog[]
  assessmentGenerationRequests AssessmentGenerationRequest[]
  questionBankItems            QuestionBankItem[]
  assessmentTemplates          AssessmentTemplate[]
  learners                     Learner[]
  scriptBatches                ScriptBatch[]
  examSessions                 ExamSession[]
  workspaceSubjects            WorkspaceSubject[]
  rubricTemplates              RubricTemplate[]
  learnerAssessmentMarks       LearnerAssessmentMark[]
  learnerAtRiskFlags           LearnerAtRiskFlag[]
  learnerInterventions         LearnerIntervention[]
  examReadinessSnapshots       ExamReadinessSnapshot[]
  paperVaultDocuments          PaperVaultDocument[]
  learnerConcessions           LearnerConcession[]
  portalAccounts               PortalAccount[]
  portalOtps                   PortalOtp[]
  parentLearnerLinks           ParentLearnerLink[]
  examVenues                   ExamVenue[]
  examinationTimetables        ExaminationTimetable[]
  examinationSlots             ExaminationSlot[]
  examinationOpsSessions       ExaminationOpsSession[]
  invigilatorAssignments       InvigilatorAssignment[]
  seatingPlans                 SeatingPlan[]
  examinationIncidents         ExaminationIncident[]
}

// ─── User (global identity — no workspace or role on the record itself) ───────

model User {
  id           String   @id @default(cuid())
  email        String   @unique
  passwordHash String
  fullName     String
  isActive     Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  memberships        WorkspaceMembership[]
  createdAssessments              Assessment[]                    @relation("AssessmentCreator")
  assignedAssessments             Assessment[]                    @relation("AssessmentAssignee")
  moderationAudits                AssessmentModerationAudit[]
  auditLogsAsActor                AuditLog[]                      @relation("AuditActor")
  auditLogsAsTarget               AuditLog[]                      @relation("AuditTarget")
  assessmentGenerationRequests    AssessmentGenerationRequest[]   @relation("GenerationRequestCreator")
  generatedAssessments            GeneratedAssessment[]           @relation("GeneratedAssessmentAuthor")
  questionBankItemsCreated        QuestionBankItem[]              @relation("QuestionBankCreator")
  questionBankItemsApproved       QuestionBankItem[]              @relation("QuestionBankApprover")
  assessmentTemplatesCreated      AssessmentTemplate[]            @relation("TemplateCreator")
  scriptBatchesCreated            ScriptBatch[]                   @relation("ScriptBatchCreator")
  teacherScriptMarks              ScriptQuestionMark[]            @relation("TeacherMarker")
  hodScriptMarks                  ScriptQuestionMark[]            @relation("HodModerator")
  scriptAnnotationLayers          ScriptAnnotationLayer[]         @relation("AnnotationAuthor")
  learnerFeedbackAuthored         LearnerFeedback[]               @relation("FeedbackAuthor")
  scriptPagesUploaded             ScriptPage[]                    @relation("ScriptPageUploader")
  scriptsFinalised                LearnerScript[]                 @relation("ScriptFinaliser")
  examSessionsCreated             ExamSession[]                   @relation("ExamSessionCreator")
  workspaceSubjectsCreated        WorkspaceSubject[]              @relation("WorkspaceSubjectCreator")
  rubricTemplatesCreated          RubricTemplate[]                @relation("RubricTemplateCreator")
  rubricTemplatesApproved         RubricTemplate[]                @relation("RubricTemplateApprover")
  learnerAssessmentMarksCaptured  LearnerAssessmentMark[]         @relation("MarkCaptureAuthor")
  rubricTeacherMarks              ScriptRubricMark[]              @relation("RubricTeacherMarker")
  rubricHodMarks                  ScriptRubricMark[]              @relation("RubricHodModerator")
  paperVaultDocumentsUploaded     PaperVaultDocument[]            @relation("PaperVaultUploader")
  interventionsCreated            LearnerIntervention[]           @relation("InterventionCreator")
  interventionsUpdated            LearnerIntervention[]           @relation("InterventionUpdater")
  examinationTimetablesCreated    ExaminationTimetable[]          @relation("ExamTimetableCreator")
  examinationOpsSessionsCreated   ExaminationOpsSession[]         @relation("ExamOpsSessionCreator")
  invigilatorAssignments          InvigilatorAssignment[]         @relation("InvigilatorUser")
  invigilatorAssignmentsCreated   InvigilatorAssignment[]         @relation("InvigilatorAssigner")
  seatingPlansCreated             SeatingPlan[]                   @relation("SeatingPlanCreator")
  examinationIncidentsReported    ExaminationIncident[]           @relation("IncidentReporter")
}

// ─── Workspace membership (user ↔ workspace) ────────────────────────────────

model WorkspaceMembership {
  id          String   @id @default(cuid())
  userId      String
  workspaceId String
  isActive    Boolean  @default(true)
  invitedAt   DateTime?
  joinedAt    DateTime @default(now())
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  user      User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  workspace Workspace         @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  roles     MembershipRole[]

  @@unique([userId, workspaceId])
  @@index([workspaceId])
  @@index([userId])
}

// ─── Membership roles (multiple roles per workspace membership) ───────────────

model MembershipRole {
  id           String        @id @default(cuid())
  membershipId String
  role         WorkspaceRole
  createdAt    DateTime      @default(now())

  membership WorkspaceMembership @relation(fields: [membershipId], references: [id], onDelete: Cascade)

  @@unique([membershipId, role])
  @@index([membershipId])
}

// ─── Audit log foundation ─────────────────────────────────────────────────────

model AuditLog {
  id            String      @id @default(cuid())
  workspaceId   String?
  actorId       String?
  targetUserId  String?
  action        AuditAction
  metadata      Json?
  ipAddress     String?
  userAgent     String?
  createdAt     DateTime    @default(now())

  workspace  Workspace? @relation(fields: [workspaceId], references: [id], onDelete: SetNull)
  actor      User?      @relation("AuditActor", fields: [actorId], references: [id], onDelete: SetNull)
  targetUser User?      @relation("AuditTarget", fields: [targetUserId], references: [id], onDelete: SetNull)

  @@index([workspaceId, createdAt])
  @@index([actorId, createdAt])
  @@index([action, createdAt])
}

// ─── Curriculum catalog (global reference data) ─────────────────────────────

model Curriculum {
  id        String   @id @default(cuid())
  code      String   @unique
  name      String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  phases            Phase[]
  subjects          Subject[]
  assessments       Assessment[]
  workspaceSubjects WorkspaceSubject[]
}

model Phase {
  id           String   @id @default(cuid())
  curriculumId String
  code         String
  name         String
  orderIndex   Int
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  curriculum  Curriculum   @relation(fields: [curriculumId], references: [id], onDelete: Cascade)
  grades      Grade[]
  subjects    Subject[]
  assessments       Assessment[]
  workspaceSubjects WorkspaceSubject[]

  @@unique([curriculumId, code])
  @@index([curriculumId, orderIndex])
}

model Grade {
  id         String   @id @default(cuid())
  phaseId    String
  code       String
  name       String
  orderIndex Int
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  phase       Phase         @relation(fields: [phaseId], references: [id], onDelete: Cascade)
  assessments       Assessment[]
  learners          Learner[]
  workspaceSubjects WorkspaceSubject[]
  examinationTimetables ExaminationTimetable[]
  examinationSlots      ExaminationSlot[]
  examinationOpsSessions ExaminationOpsSession[]
  examReadinessSnapshots ExamReadinessSnapshot[]

  @@unique([phaseId, code])
  @@index([phaseId, orderIndex])
}

model Subject {
  id           String   @id @default(cuid())
  curriculumId String
  phaseId      String
  code         String
  name         String
  category     String?
  active       Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  curriculum  Curriculum   @relation(fields: [curriculumId], references: [id], onDelete: Cascade)
  phase       Phase        @relation(fields: [phaseId], references: [id], onDelete: Cascade)
  assessments       Assessment[]
  workspaceSubjects WorkspaceSubject[]
  rubricTemplates   RubricTemplate[]
  examinationTimetables ExaminationTimetable[]
  examinationSlots      ExaminationSlot[]
  examinationOpsSessions ExaminationOpsSession[]
  examReadinessSnapshots ExamReadinessSnapshot[]

  @@unique([phaseId, code])
  @@index([curriculumId, phaseId])
  @@index([phaseId, active])
}

// ─── Assessment (core entity — workspace-scoped, catalog-linked) ──────────────

model Assessment {
  id          String           @id @default(cuid())
  workspaceId String
  title       String
  description String?

  curriculumId   String
  phaseId        String
  gradeId        String
  subjectId      String
  assessmentType AssessmentType
  term           String?
  session        String?

  totalMarks       Int
  weightingPercent Float?
  durationMinutes  Int?

  assessmentDate      DateTime?
  dueDate             DateTime?
  markingDeadline     DateTime?
  moderationDeadline  DateTime?

  rubricTemplateId String?

  status AssessmentStatus @default(DRAFT)

  creatorTeacherId String
  assignedUserId   String?

  aiMetadata Json?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  workspace        Workspace                   @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  curriculum       Curriculum                  @relation(fields: [curriculumId], references: [id])
  phase            Phase                       @relation(fields: [phaseId], references: [id])
  grade            Grade                       @relation(fields: [gradeId], references: [id])
  subject          Subject                     @relation(fields: [subjectId], references: [id])
  creatorTeacher   User                        @relation("AssessmentCreator", fields: [creatorTeacherId], references: [id])
  assignedUser     User?                       @relation("AssessmentAssignee", fields: [assignedUserId], references: [id])
  moderationAudits    AssessmentModerationAudit[]
  questions           AssessmentQuestion[]
  generatedVersions   GeneratedAssessment[]
  scriptBatches       ScriptBatch[]
  learnerScripts      LearnerScript[]
  examSessions           ExamSession[]
  rubricTemplate         RubricTemplate?         @relation(fields: [rubricTemplateId], references: [id], onDelete: SetNull)
  learnerAssessmentMarks LearnerAssessmentMark[]
  paperVaultDocuments    PaperVaultDocument[]
  examinationSlots       ExaminationSlot[]
  examinationOpsSessions ExaminationOpsSession[]

  analyticsSnapshot Json?

  resultsPublishRequestedAt DateTime?
  publishedAt               DateTime?

  @@index([workspaceId, status])
  @@index([workspaceId, curriculumId])
  @@index([creatorTeacherId])
  @@index([assignedUserId])
  @@index([workspaceId, assessmentDate])
  @@index([workspaceId, dueDate])
  @@index([rubricTemplateId])
}

model AssessmentModerationAudit {
  id            String           @id @default(cuid())
  assessmentId  String
  action        ModerationAction
  fromStatus    AssessmentStatus
  toStatus      AssessmentStatus
  performedById String
  comment       String?
  createdAt     DateTime         @default(now())

  assessment  Assessment @relation(fields: [assessmentId], references: [id], onDelete: Cascade)
  performedBy User       @relation(fields: [performedById], references: [id])

  @@index([assessmentId, createdAt])
  @@index([performedById])
}

model AssessmentQuestion {
  id             String   @id @default(cuid())
  assessmentId   String
  questionNumber String
  section        String?
  questionText   String
  topic          String?
  marks          Int
  cognitiveLevel String?
  difficulty     String?
  expectedAnswer String?
  memoNotes      String?
  rubricNotes    String?
  orderIndex     Int

  analyticsMetadata Json?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  assessment Assessment @relation(fields: [assessmentId], references: [id], onDelete: Cascade)
  scriptMarks ScriptQuestionMark[]

  @@unique([assessmentId, orderIndex])
  @@index([assessmentId])
  @@index([assessmentId, topic])
  @@index([assessmentId, cognitiveLevel])
  @@index([assessmentId, difficulty])
}

// ─── AI assessment generation foundation ──────────────────────────────────────

model AssessmentGenerationRequest {
  id             String                   @id @default(cuid())
  workspaceId    String
  createdById    String
  curriculumId   String
  phaseId        String
  gradeId        String
  subjectId      String
  assessmentType AssessmentType
  outputMode     GenerationMode
  term           String?
  title          String
  totalMarks     Int
  difficulty     GenerationDifficulty
  instructions   String?
  topics         Json
  status         AssessmentGenerationStatus @default(DRAFT)
  createdAt      DateTime                 @default(now())
  updatedAt      DateTime                 @updatedAt

  workspace  Workspace             @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  createdBy  User                  @relation("GenerationRequestCreator", fields: [createdById], references: [id])
  generated  GeneratedAssessment[]

  @@index([workspaceId, status])
  @@index([createdById, createdAt])
}

model GeneratedAssessment {
  id                  String   @id @default(cuid())
  requestId           String
  assessmentId        String?
  version             Int
  generatedBy         String
  generationMetadata  Json
  createdAt           DateTime @default(now())

  request     AssessmentGenerationRequest @relation(fields: [requestId], references: [id], onDelete: Cascade)
  assessment  Assessment?                 @relation(fields: [assessmentId], references: [id], onDelete: SetNull)
  author      User                        @relation("GeneratedAssessmentAuthor", fields: [generatedBy], references: [id])

  @@unique([requestId, version])
  @@index([requestId, createdAt])
  @@index([assessmentId])
}

// ─── Curriculum topics (topic foundation for AI & analytics) ──────────────────

model CurriculumTopic {
  id           String   @id @default(cuid())
  curriculumId String
  phaseId      String
  gradeId      String
  subjectId    String
  topic        String
  subtopic     String   @default("")
  orderIndex   Int      @default(0)
  active       Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@unique([curriculumId, phaseId, gradeId, subjectId, topic, subtopic])
  @@index([curriculumId, phaseId, gradeId, subjectId, active])
}

// ─── Question bank (reusable questions) ───────────────────────────────────────

model QuestionBankItem {
  id             String             @id @default(cuid())
  workspaceId    String
  curriculumId   String
  phaseId        String
  gradeId        String
  subjectId      String
  topic          String?
  subtopic       String?
  questionText   String
  expectedAnswer String?
  memoNotes      String?
  rubricNotes    String?
  marks          Int
  difficulty     String?
  cognitiveLevel String?
  source         QuestionBankSource
  status         QuestionBankStatus @default(DRAFT)
  createdById    String
  approvedById   String?
  approvedAt     DateTime?
  archivedAt     DateTime?
  usageCount     Int                @default(0)
  firstUsedAt    DateTime?
  lastUsedAt     DateTime?
  metadata       Json?
  createdAt      DateTime           @default(now())
  updatedAt      DateTime           @updatedAt

  workspace  Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  createdBy  User      @relation("QuestionBankCreator", fields: [createdById], references: [id])
  approvedBy User?     @relation("QuestionBankApprover", fields: [approvedById], references: [id])

  @@index([workspaceId, status])
  @@index([workspaceId, curriculumId, subjectId])
  @@index([workspaceId, topic])
  @@index([createdById])
}

// ─── Assessment templates (reusable assessment structures) ────────────────────

model AssessmentTemplate {
  id           String                   @id @default(cuid())
  workspaceId  String
  curriculumId String
  phaseId      String
  gradeId      String
  subjectId    String
  name         String
  description  String?
  createdById  String
  status       AssessmentTemplateStatus @default(ACTIVE)
  createdAt    DateTime                 @default(now())
  updatedAt    DateTime                 @updatedAt

  workspace  Workspace                   @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  createdBy  User                        @relation("TemplateCreator", fields: [createdById], references: [id])
  questions  AssessmentTemplateQuestion[]

  @@index([workspaceId, status])
  @@index([workspaceId, curriculumId, subjectId])
  @@index([createdById])
}

model AssessmentTemplateQuestion {
  id             String @id @default(cuid())
  templateId     String
  questionText   String
  topic          String?
  subtopic       String?
  expectedAnswer String?
  memoNotes      String?
  rubricNotes    String?
  marks          Int
  difficulty     String?
  cognitiveLevel String?
  orderIndex     Int

  template AssessmentTemplate @relation(fields: [templateId], references: [id], onDelete: Cascade)

  @@index([templateId, orderIndex])
}

// ─── Learner scripts & manual marking ───────────────────────────────────────────

model Learner {
  id            String   @id @default(cuid())
  workspaceId   String
  learnerNumber String
  firstName     String
  lastName      String
  gradeId       String
  className     String?
  active        Boolean  @default(true)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  workspace          Workspace           @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  grade              Grade               @relation(fields: [gradeId], references: [id])
  learnerScripts          LearnerScript[]
  examDeviceSessions      ExamDeviceSession[]
  learnerAssessmentMarks  LearnerAssessmentMark[]
  atRiskFlags             LearnerAtRiskFlag[]
  interventions           LearnerIntervention[]
  concessions             LearnerConcession[]
  portalAccount           PortalAccount?
  parentLinks             ParentLearnerLink[]
  seatingAllocations      SeatingAllocation[]
  examinationIncidents    ExaminationIncident[]

  @@unique([workspaceId, learnerNumber])
  @@index([workspaceId, active])
  @@index([gradeId])
}

model ScriptBatch {
  id            String            @id @default(cuid())
  workspaceId   String
  assessmentId  String
  createdById   String
  title         String
  status        ScriptBatchStatus @default(DRAFT)
  totalLearners Int               @default(0)
  totalScripts  Int               @default(0)
  totalPages      Int               @default(0)
  examSessionMode Boolean           @default(false)
  createdAt       DateTime          @default(now())
  updatedAt       DateTime          @updatedAt

  workspace      Workspace       @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  assessment     Assessment      @relation(fields: [assessmentId], references: [id], onDelete: Cascade)
  createdBy      User            @relation("ScriptBatchCreator", fields: [createdById], references: [id])
  learnerScripts LearnerScript[]
  examSessions   ExamSession[]

  @@index([workspaceId, status])
  @@index([assessmentId])
  @@index([createdById])
}

model LearnerScript {
  id               String              @id @default(cuid())
  batchId          String
  learnerId        String
  assessmentId     String
  scriptNumber     String
  pageCount        Int                 @default(0)
  status           LearnerScriptStatus @default(NOT_MARKED)
  teacherTotal     Float?
  hodTotal         Float?
  finalTotal       Float?
  confidence       Float?
  submittedToHodAt   DateTime?
  approvedAt       DateTime?
  teacherLayerLocked Boolean             @default(false)
  hodLayerLocked     Boolean             @default(false)
  finalisedAt                DateTime?
  finalisedById              String?
  markDifference             Float?
  teacherPercentage          Float?
  hodPercentage              Float?
  finalPercentage            Float?
  moderationVariancePercent  Float?
  varianceLevel              ModerationVarianceLevel @default(NONE)
  createdAt                  DateTime                @default(now())
  updatedAt                  DateTime                @updatedAt

  batch          ScriptBatch            @relation(fields: [batchId], references: [id], onDelete: Cascade)
  learner        Learner                @relation(fields: [learnerId], references: [id], onDelete: Cascade)
  assessment     Assessment             @relation(fields: [assessmentId], references: [id], onDelete: Cascade)
  finalisedBy    User?                  @relation("ScriptFinaliser", fields: [finalisedById], references: [id])
  questionMarks  ScriptQuestionMark[]
  layers         ScriptAnnotationLayer[]
  feedback       LearnerFeedback[]
  pages                 ScriptPage[]
  learnerAssessmentMark LearnerAssessmentMark?
  rubricMarks           ScriptRubricMark[]

  @@unique([batchId, learnerId])
  @@index([batchId, status])
  @@index([assessmentId])
  @@index([learnerId])
}

model ScriptQuestionMark {
  id                   String   @id @default(cuid())
  learnerScriptId      String
  assessmentQuestionId String
  questionNumber       String
  maxMarks             Int
  teacherMark          Float?
  hodMark              Float?
  finalMark            Float?
  teacherComment       String?
  hodComment           String?
  teacherAnnotatedText String?
  hodAnnotatedText     String?
  teacherMarkedById    String?
  hodModeratedById     String?
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt

  learnerScript      LearnerScript      @relation(fields: [learnerScriptId], references: [id], onDelete: Cascade)
  assessmentQuestion AssessmentQuestion @relation(fields: [assessmentQuestionId], references: [id], onDelete: Cascade)
  teacherMarkedBy    User?              @relation("TeacherMarker", fields: [teacherMarkedById], references: [id])
  hodModeratedBy     User?              @relation("HodModerator", fields: [hodModeratedById], references: [id])

  @@unique([learnerScriptId, assessmentQuestionId])
  @@index([learnerScriptId])
  @@index([assessmentQuestionId])
}

model ScriptPage {
  id              String   @id @default(cuid())
  learnerScriptId String
  pageNumber      Int
  fileName        String
  filePath        String
  mimeType        String
  fileSize        Int
  width           Int?
  height          Int?
  uploadedById    String
  uploadedAt      DateTime @default(now())

  learnerScript LearnerScript @relation(fields: [learnerScriptId], references: [id], onDelete: Cascade)
  uploadedBy    User          @relation("ScriptPageUploader", fields: [uploadedById], references: [id])

  @@unique([learnerScriptId, pageNumber])
  @@index([learnerScriptId])
}

model ScriptAnnotationLayer {
  id              String              @id @default(cuid())
  learnerScriptId String
  layerType       AnnotationLayerType
  color           String
  createdById     String
  annotationData  Json?
  createdAt       DateTime            @default(now())
  updatedAt       DateTime            @updatedAt

  learnerScript LearnerScript @relation(fields: [learnerScriptId], references: [id], onDelete: Cascade)
  createdBy     User          @relation("AnnotationAuthor", fields: [createdById], references: [id])

  @@unique([learnerScriptId, layerType])
  @@index([learnerScriptId])
}

model ExamSession {
  id                String    @id @default(cuid())
  workspaceId       String
  assessmentId      String?
  scriptBatchId     String?
  title             String
  examSessionMode   Boolean   @default(true)
  kioskInstructions String?
  startedAt         DateTime  @default(now())
  endedAt           DateTime?
  createdById       String
  active            Boolean   @default(true)
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  workspace      Workspace           @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  assessment     Assessment?         @relation(fields: [assessmentId], references: [id], onDelete: SetNull)
  scriptBatch    ScriptBatch?        @relation(fields: [scriptBatchId], references: [id], onDelete: SetNull)
  createdBy      User                @relation("ExamSessionCreator", fields: [createdById], references: [id])
  deviceSessions ExamDeviceSession[]

  @@index([workspaceId, active])
  @@index([assessmentId])
  @@index([scriptBatchId])
}

model ExamDeviceSession {
  id            String    @id @default(cuid())
  examSessionId String
  learnerId     String
  deviceId      String
  deviceLabel   String?
  userAgent     String?
  ipAddress     String?
  registeredAt  DateTime  @default(now())
  lastSeenAt    DateTime  @default(now())
  endedAt       DateTime?
  active        Boolean   @default(true)

  examSession ExamSession @relation(fields: [examSessionId], references: [id], onDelete: Cascade)
  learner     Learner     @relation(fields: [learnerId], references: [id], onDelete: Cascade)

  @@index([examSessionId, learnerId, active])
  @@index([examSessionId, active])
  @@index([deviceId])
}

model LearnerFeedback {
  id                String   @id @default(cuid())
  learnerScriptId   String
  teacherFeedback   String?
  hodFeedback       String?
  interventionNotes String?
  createdById       String
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  learnerScript LearnerScript @relation(fields: [learnerScriptId], references: [id], onDelete: Cascade)
  createdBy     User          @relation("FeedbackAuthor", fields: [createdById], references: [id])

  @@index([learnerScriptId, createdAt])
  @@index([createdById])
}

// ─── Workspace subject offerings (school-managed) ─────────────────────────────

model WorkspaceSubject {
  id               String    @id @default(cuid())
  workspaceId      String
  name             String
  code             String
  curriculumId     String
  phaseId          String
  gradeId          String
  catalogSubjectId String?
  department       String?
  active           Boolean   @default(true)
  archivedAt       DateTime?
  createdById      String
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  workspace      Workspace   @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  curriculum     Curriculum  @relation(fields: [curriculumId], references: [id])
  phase          Phase       @relation(fields: [phaseId], references: [id])
  grade          Grade       @relation(fields: [gradeId], references: [id])
  catalogSubject Subject?    @relation(fields: [catalogSubjectId], references: [id], onDelete: SetNull)
  createdBy      User        @relation("WorkspaceSubjectCreator", fields: [createdById], references: [id])

  @@unique([workspaceId, code])
  @@index([workspaceId, active])
  @@index([workspaceId, department])
  @@index([workspaceId, gradeId])
}

// ─── Rubric templates (structured marking criteria) ───────────────────────────

model RubricTemplate {
  id           String               @id @default(cuid())
  workspaceId  String
  name         String
  description  String?
  subjectId    String?
  scope        RubricTemplateScope
  status       RubricTemplateStatus @default(DRAFT)
  totalMarks   Int                  @default(0)
  createdById  String
  approvedById String?
  approvedAt   DateTime?
  archivedAt   DateTime?
  createdAt    DateTime             @default(now())
  updatedAt    DateTime             @updatedAt

  workspace  Workspace        @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  subject    Subject?         @relation(fields: [subjectId], references: [id], onDelete: SetNull)
  createdBy  User             @relation("RubricTemplateCreator", fields: [createdById], references: [id])
  approvedBy User?            @relation("RubricTemplateApprover", fields: [approvedById], references: [id])
  criteria   RubricCriterion[]
  assessments Assessment[]

  @@index([workspaceId, status])
  @@index([workspaceId, subjectId])
  @@index([createdById])
}

model RubricCriterion {
  id               String @id @default(cuid())
  rubricTemplateId String
  name             String
  description      String?
  maxMarks         Int
  orderIndex       Int

  template    RubricTemplate    @relation(fields: [rubricTemplateId], references: [id], onDelete: Cascade)
  scriptMarks ScriptRubricMark[]

  @@unique([rubricTemplateId, orderIndex])
  @@index([rubricTemplateId])
}

model ScriptRubricMark {
  id                String   @id @default(cuid())
  learnerScriptId   String
  rubricCriterionId String
  teacherMark       Float?
  hodMark           Float?
  finalMark         Float?
  teacherComment    String?
  hodComment        String?
  teacherMarkedById String?
  hodModeratedById  String?
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  learnerScript   LearnerScript   @relation(fields: [learnerScriptId], references: [id], onDelete: Cascade)
  rubricCriterion RubricCriterion @relation(fields: [rubricCriterionId], references: [id], onDelete: Cascade)
  teacherMarkedBy User?           @relation("RubricTeacherMarker", fields: [teacherMarkedById], references: [id])
  hodModeratedBy  User?           @relation("RubricHodModerator", fields: [hodModeratedById], references: [id])

  @@unique([learnerScriptId, rubricCriterionId])
  @@index([learnerScriptId])
}

// ─── One-time mark capture (canonical learner marks) ──────────────────────────

model LearnerAssessmentMark {
  id              String            @id @default(cuid())
  workspaceId     String
  assessmentId    String
  learnerId       String
  learnerScriptId String?           @unique
  teacherMark     Float?
  hodMark         Float?
  finalMark       Float?
  finalPercentage Float?
  comment         String?
  source          MarkCaptureSource @default(SCRIPT_MARKING)
  capturedAt      DateTime          @default(now())
  capturedById    String
  updatedAt       DateTime          @updatedAt

  workspace     Workspace      @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  assessment    Assessment     @relation(fields: [assessmentId], references: [id], onDelete: Cascade)
  learner       Learner        @relation(fields: [learnerId], references: [id], onDelete: Cascade)
  learnerScript LearnerScript? @relation(fields: [learnerScriptId], references: [id], onDelete: SetNull)
  capturedBy    User           @relation("MarkCaptureAuthor", fields: [capturedById], references: [id])

  @@unique([assessmentId, learnerId])
  @@index([workspaceId, assessmentId])
  @@index([learnerId, assessmentId])
  @@index([assessmentId, finalMark])
}

model LearnerAtRiskFlag {
  id          String       @id @default(cuid())
  workspaceId String
  learnerId   String
  reason      AtRiskReason
  active      Boolean      @default(true)
  metadata    Json?
  flaggedAt   DateTime     @default(now())
  clearedAt   DateTime?

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  learner   Learner   @relation(fields: [learnerId], references: [id], onDelete: Cascade)

  @@index([workspaceId, active])
  @@index([learnerId, active])
  @@index([workspaceId, learnerId, reason, active])
}

model LearnerIntervention {
  id                String             @id @default(cuid())
  workspaceId       String
  learnerId         String
  riskReason        AtRiskReason
  dateFlagged       DateTime
  teacherNotes      String?
  parentMeetingDate DateTime?
  interventionNotes String?
  reviewDate        DateTime?
  status            InterventionStatus @default(OPEN)
  createdById       String
  updatedById       String?
  createdAt         DateTime           @default(now())
  updatedAt         DateTime           @updatedAt

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  learner   Learner   @relation(fields: [learnerId], references: [id], onDelete: Cascade)
  createdBy User      @relation("InterventionCreator", fields: [createdById], references: [id])
  updatedBy User?     @relation("InterventionUpdater", fields: [updatedById], references: [id])

  @@index([workspaceId, status])
  @@index([learnerId, status])
  @@index([workspaceId, learnerId])
}

model ExamReadinessSnapshot {
  id                  String              @id @default(cuid())
  workspaceId         String
  scope               ExamReadinessScope  @default(SCHOOL)
  department          String?
  gradeId             String?
  subjectId           String?
  readinessPercentage Float
  status              ExamReadinessStatus
  components          Json
  calculatedAt        DateTime            @default(now())

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  grade     Grade?    @relation(fields: [gradeId], references: [id], onDelete: SetNull)
  subject   Subject?  @relation(fields: [subjectId], references: [id], onDelete: SetNull)

  @@index([workspaceId, scope, calculatedAt])
  @@index([workspaceId, department])
  @@index([workspaceId, gradeId])
  @@index([workspaceId, subjectId])
}

// ─── Examination operations (Phase 6) ─────────────────────────────────────────

model ExamVenue {
  id          String   @id @default(cuid())
  workspaceId String
  name        String
  location    String?
  capacity    Int
  rows        Int      @default(10)
  columns     Int      @default(8)
  active      Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  workspace              Workspace               @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  examinationSlots       ExaminationSlot[]
  examinationOpsSessions ExaminationOpsSession[]
  invigilatorAssignments InvigilatorAssignment[]
  seatingPlans           SeatingPlan[]
  examinationIncidents   ExaminationIncident[]

  @@index([workspaceId, active])
}

model ExaminationTimetable {
  id          String   @id @default(cuid())
  workspaceId String
  title       String
  description String?
  gradeId     String?
  subjectId   String?
  startDate   DateTime
  endDate     DateTime
  active      Boolean  @default(true)
  createdById String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  grade     Grade?    @relation(fields: [gradeId], references: [id], onDelete: SetNull)
  subject   Subject?  @relation(fields: [subjectId], references: [id], onDelete: SetNull)
  createdBy User      @relation("ExamTimetableCreator", fields: [createdById], references: [id])
  slots     ExaminationSlot[]

  @@index([workspaceId, startDate, endDate])
}

model ExaminationSlot {
  id              String   @id @default(cuid())
  workspaceId     String
  timetableId     String?
  title           String
  gradeId         String?
  subjectId       String?
  assessmentId    String?
  venueId         String?
  startTime       DateTime
  endTime         DateTime
  durationMinutes Int
  notes           String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  workspace   Workspace             @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  timetable   ExaminationTimetable? @relation(fields: [timetableId], references: [id], onDelete: SetNull)
  grade       Grade?                @relation(fields: [gradeId], references: [id], onDelete: SetNull)
  subject     Subject?              @relation(fields: [subjectId], references: [id], onDelete: SetNull)
  assessment  Assessment?           @relation(fields: [assessmentId], references: [id], onDelete: SetNull)
  venue       ExamVenue?            @relation(fields: [venueId], references: [id], onDelete: SetNull)
  opsSession  ExaminationOpsSession?

  @@index([workspaceId, startTime, endTime])
  @@index([venueId, startTime])
  @@index([gradeId, startTime])
  @@index([timetableId])
}

model ExaminationOpsSession {
  id              String                      @id @default(cuid())
  workspaceId     String
  slotId          String?                     @unique
  title           String
  gradeId         String?
  subjectId       String?
  assessmentId    String?
  venueId         String?
  scheduledStart  DateTime
  scheduledEnd    DateTime
  actualStart     DateTime?
  actualEnd       DateTime?
  status          ExaminationOpsSessionStatus @default(SCHEDULED)
  durationMinutes Int
  learnerCount    Int                         @default(0)
  notes           String?
  createdById     String
  createdAt       DateTime                    @default(now())
  updatedAt       DateTime                    @updatedAt

  workspace              Workspace               @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  slot                   ExaminationSlot?        @relation(fields: [slotId], references: [id], onDelete: SetNull)
  grade                  Grade?                  @relation(fields: [gradeId], references: [id], onDelete: SetNull)
  subject                Subject?                @relation(fields: [subjectId], references: [id], onDelete: SetNull)
  assessment             Assessment?             @relation(fields: [assessmentId], references: [id], onDelete: SetNull)
  venue                  ExamVenue?              @relation(fields: [venueId], references: [id], onDelete: SetNull)
  createdBy              User                    @relation("ExamOpsSessionCreator", fields: [createdById], references: [id])
  invigilatorAssignments InvigilatorAssignment[]
  seatingPlans           SeatingPlan[]
  examinationIncidents   ExaminationIncident[]

  @@index([workspaceId, status])
  @@index([workspaceId, scheduledStart])
  @@index([venueId])
}

model InvigilatorAssignment {
  id           String   @id @default(cuid())
  workspaceId  String
  sessionId    String
  userId       String
  venueId      String?
  isLead       Boolean  @default(false)
  assignedById String
  assignedAt   DateTime @default(now())

  workspace  Workspace             @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  session    ExaminationOpsSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  user       User                  @relation("InvigilatorUser", fields: [userId], references: [id])
  venue      ExamVenue?            @relation(fields: [venueId], references: [id], onDelete: SetNull)
  assignedBy User                  @relation("InvigilatorAssigner", fields: [assignedById], references: [id])

  @@unique([sessionId, userId])
  @@index([workspaceId, userId])
  @@index([sessionId])
}

model SeatingPlan {
  id          String   @id @default(cuid())
  workspaceId String
  sessionId   String
  venueId     String
  rows        Int
  columns     Int
  generatedAt DateTime @default(now())
  createdById String

  workspace   Workspace             @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  session     ExaminationOpsSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  venue       ExamVenue             @relation(fields: [venueId], references: [id])
  createdBy   User                  @relation("SeatingPlanCreator", fields: [createdById], references: [id])
  allocations SeatingAllocation[]

  @@index([sessionId])
}

model SeatingAllocation {
  id            String @id @default(cuid())
  seatingPlanId String
  learnerId     String
  row           Int
  column        Int
  seatLabel     String

  seatingPlan SeatingPlan @relation(fields: [seatingPlanId], references: [id], onDelete: Cascade)
  learner     Learner     @relation(fields: [learnerId], references: [id], onDelete: Cascade)

  @@unique([seatingPlanId, learnerId])
  @@unique([seatingPlanId, row, column])
}

model ExaminationIncident {
  id              String                    @id @default(cuid())
  workspaceId     String
  sessionId       String?
  learnerId       String?
  venueId         String?
  incidentType    ExaminationIncidentType
  description     String
  status          ExaminationIncidentStatus @default(OPEN)
  reportedAt      DateTime                  @default(now())
  resolutionNotes String?
  closedAt        DateTime?
  reportedById    String
  createdAt       DateTime                  @default(now())
  updatedAt       DateTime                  @updatedAt

  workspace  Workspace              @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  session    ExaminationOpsSession? @relation(fields: [sessionId], references: [id], onDelete: SetNull)
  learner    Learner?               @relation(fields: [learnerId], references: [id], onDelete: SetNull)
  venue      ExamVenue?             @relation(fields: [venueId], references: [id], onDelete: SetNull)
  reportedBy User                   @relation("IncidentReporter", fields: [reportedById], references: [id])

  @@index([workspaceId, status])
  @@index([sessionId])
}

// ─── Secure examination paper vault ───────────────────────────────────────────

model PaperVaultDocument {
  id               String            @id @default(cuid())
  workspaceId      String
  assessmentId     String
  documentGroupId  String
  documentType     PaperDocumentType
  versionNumber    Int
  fileName         String
  storedPath       String
  mimeType         String
  fileSize         Int
  status           PaperVaultStatus  @default(DRAFT)
  isCurrentVersion Boolean           @default(true)
  uploadedById     String
  releaseAt        DateTime?
  expiresAt        DateTime?
  workflowComment  String?
  archivedAt       DateTime?
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt

  workspace   Workspace  @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  assessment  Assessment @relation(fields: [assessmentId], references: [id], onDelete: Cascade)
  uploadedBy  User       @relation("PaperVaultUploader", fields: [uploadedById], references: [id])

  @@unique([documentGroupId, versionNumber])
  @@index([workspaceId, assessmentId])
  @@index([assessmentId, status])
  @@index([documentGroupId, isCurrentVersion])
  @@index([uploadedById])
}

// ─── Learner concessions register ─────────────────────────────────────────────

model LearnerConcession {
  id            String         @id @default(cuid())
  workspaceId   String
  learnerId     String
  concessionType ConcessionType
  description   String?
  effectiveDate DateTime
  expiryDate    DateTime?
  active        Boolean        @default(true)
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  learner   Learner   @relation(fields: [learnerId], references: [id], onDelete: Cascade)

  @@index([workspaceId, active])
  @@index([learnerId, active])
  @@index([workspaceId, learnerId, active])
}

// ─── Parent & learner academic progress portal ────────────────────────────────

model PortalAccount {
  id          String         @id @default(cuid())
  workspaceId String
  type        PortalUserType
  email       String?
  fullName    String?
  learnerId   String?        @unique
  isActive    Boolean        @default(true)
  lastLoginAt DateTime?
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt

  workspace   Workspace            @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  learner     Learner?             @relation(fields: [learnerId], references: [id], onDelete: Cascade)
  parentLinks ParentLearnerLink[]  @relation("ParentAccount")

  @@unique([workspaceId, email])
  @@index([workspaceId, type, isActive])
}

model ParentLearnerLink {
  id              String   @id @default(cuid())
  workspaceId     String
  parentAccountId String
  learnerId       String
  createdAt       DateTime @default(now())

  workspace     Workspace     @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  parentAccount PortalAccount @relation("ParentAccount", fields: [parentAccountId], references: [id], onDelete: Cascade)
  learner       Learner       @relation(fields: [learnerId], references: [id], onDelete: Cascade)

  @@unique([parentAccountId, learnerId])
  @@index([workspaceId, learnerId])
  @@index([parentAccountId])
}

model PortalOtp {
  id          String         @id @default(cuid())
  workspaceId String
  identifier  String
  portalType  PortalUserType
  code        String
  expiresAt   DateTime
  usedAt      DateTime?
  createdAt   DateTime       @default(now())

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@index([workspaceId, identifier, portalType, expiresAt])
}
