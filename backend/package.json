{
  "name": "scriptcheck-backend",
  "version": "0.7.3",
  "private": true,
  "description": "ScriptCheck API",
  "main": "dist/index.js",
  "scripts": {
    "build": "prisma generate && tsc",
    "typecheck": "prisma generate && tsc --noEmit",
    "dev": "tsc && node dist/index.js",
    "dev:watch": "tsc && (tsc -w & node --watch dist/index.js)",
    "start": "node dist/index.js",
    "start:beta": "node scripts/verify-migration-integrity.mjs && node dist/index.js",
    "db:generate": "prisma generate",
    "db:verify-integrity": "node scripts/verify-migration-integrity.mjs",
    "db:release-gate": "node scripts/verify-database-release-readiness.mjs",
    "db:migrate:deploy": "prisma migrate deploy",
    "db:push": "node scripts/db-push-blocked.mjs",
    "db:push:disposable": "node scripts/db-push-disposable.mjs",
    "db:studio": "prisma studio",
    "seed": "tsc && node dist/seed.js",
    "test": "node --test --test-concurrency=1 scripts/lib/*.test.mjs",
    "test:unit": "tsc && node --test dist/services/*.test.js",
    "verify:ocr": "tsc && node dist/scripts/verifyOcrPipeline.js",
    "verify:past-paper": "tsc && node dist/scripts/verifyPastPaperExtraction.js",
    "verify:framework": "tsc && node dist/scripts/verifyFrameworkEngine.js",
    "verify:framework-auto": "tsc && node dist/scripts/verifyFrameworkAutoDetection.js",
    "verify:content-quality": "tsc && node dist/scripts/verifyContentQuality.js",
    "verify:review-workspace": "tsc && node dist/scripts/verifyReviewWorkspace.js"
  },
  "dependencies": {
    "@napi-rs/canvas": "^1.0.0",
    "@prisma/client": "^5.22.0",
    "bcryptjs": "^3.0.3",
    "cors": "^2.8.6",
    "dotenv": "^17.3.1",
    "express": "^5.2.1",
    "image-size": "^2.0.2",
    "jsonwebtoken": "^9.0.3",
    "mammoth": "^1.12.0",
    "multer": "^2.1.1",
    "pdf-lib": "^1.17.1",
    "pdf-parse": "^1.1.4",
    "pdfjs-dist": "^6.0.227",
    "pdfkit": "^0.19.0",
    "prisma": "^5.22.0",
    "tesseract.js": "^6.0.1",
    "xlsx": "^0.18.5"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/multer": "^2.1.0",
    "@types/node": "^22.19.11",
    "@types/pdfkit": "^0.17.6",
    "typescript": "^5.7.0"
  }
}
