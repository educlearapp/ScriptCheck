{
  "name": "scriptcheck-backend",
  "version": "0.5.0",
  "private": true,
  "description": "ScriptCheck API",
  "main": "dist/index.js",
  "scripts": {
    "build": "prisma generate && tsc",
    "typecheck": "prisma generate && tsc --noEmit",
    "dev": "tsc && node dist/index.js",
    "start": "node dist/index.js",
    "db:generate": "prisma generate",
    "db:push": "prisma db push",
    "db:studio": "prisma studio",
    "seed": "tsc && node dist/seed.js"
  },
  "dependencies": {
    "@prisma/client": "^5.22.0",
    "bcryptjs": "^3.0.3",
    "cors": "^2.8.6",
    "dotenv": "^17.3.1",
    "express": "^5.2.1",
    "image-size": "^2.0.2",
    "jsonwebtoken": "^9.0.3",
    "multer": "^2.1.1",
    "pdf-lib": "^1.17.1",
    "pdfkit": "^0.19.0",
    "prisma": "^5.22.0",
    "xlsx": "^0.18.5"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/multer": "^2.1.0",
    "@types/node": "^22.19.11",
    "@types/pdfkit": "^0.17.6",
    "typescript": "^5.7.0"
  }
}
